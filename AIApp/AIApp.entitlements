<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CloudKit sync for the SwiftData store (mini-apps). Uses the device's
	     iCloud account — the app has no login of its own. Requires a paid
	     team; the container is created on first provisioning. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.aiity.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- CloudKit delivers change notifications via silent pushes. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
