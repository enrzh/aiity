    "Arbeitet durch, bis die App steht.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps working until the app is done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabaja sin parar hasta que la app esté lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travaille jusqu'à ce que l'app soit prête."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalha sem parar até a app estar pronta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira dritto finché l'app non è pronta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续推进，直到应用做好。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが完成するまで一気に進める。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает без остановок, пока приложение не готово."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يواصل العمل حتى يجهز التطبيق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब तक काम करता रहता है जब तक ऐप तैयार न हो जाए।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ প্রস্তুত না হওয়া পর্যন্ত কাজ করে যায়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ تیار ہونے تک کام کرتا رہتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terus bekerja hingga aplikasi siap."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama hazır olana kadar çalışmaya devam eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục làm việc cho đến khi ứng dụng sẵn sàng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 완성될 때까지 계속 작업합니다."
          }
        }
      }
    },
    "Archiv unlesbar UND nicht sicherbar — Schreiben gesperrt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive unreadable AND can't be backed up — writing blocked"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo ilegible Y no se puede respaldar — escritura bloqueada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive illisible ET impossible à sauvegarder — écriture bloquée"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivo ilegível E impossível de salvaguardar — escrita bloqueada"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivio illeggibile E non salvabile — scrittura bloccata"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存档无法读取且无法备份 — 已禁止写入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブが読めず退避もできません — 書き込み停止"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив не читается И не сохраняется — запись заблокирована"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأرشيف غير مقروء ولا يمكن تأمينه — الكتابة موقوفة"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आर्काइव पढ़ने योग्य नहीं है और सुरक्षित भी नहीं किया जा सका — लिखना बंद कर दिया गया है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আর্কাইভ পড়া যাচ্ছে না এবং সেভও করা যাচ্ছে না — লেখা বন্ধ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرکائیو پڑھا نہیں جا سکتا اور محفوظ بھی نہیں کیا جا سکتا — لکھنا بند"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arsip tidak dapat dibaca DAN tidak dapat disimpan — penulisan diblokir"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşiv okunamıyor VE kaydedilemiyor — yazma kilitli"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho lưu trữ không đọc được VÀ không thể sao lưu — chặn ghi"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아카이브를 읽을 수 없고 백업도 할 수 없음 — 쓰기 잠김"
          }
        }
      }
    },
