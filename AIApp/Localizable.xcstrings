            "state": "translated",
            "value": "[%@ tidak memiliki akun — masukkan Key di Provider.]"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@'nin hesabı yok — Sağlayıcı'da bir Key girin.]"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@ không có tài khoản — nhập Key trong Provider.]"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@에 계정이 없습니다 — Provider에서 Key를 입력하세요.]"
          }
        }
      }
    },
