    " — Einstellungen → Modelle laden und ein anderes Modell wählen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " — Settings → Load models, then pick a different one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " — Ajustes → Cargar modelos y elige otro modelo."
          }
        },
        "fr": {
