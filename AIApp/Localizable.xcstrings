    "Antwort unvollständig — bitte erneut senden (kürzere Anfrage hilft).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرد غير مكتمل — أعد الإرسال (طلب أقصر يساعد)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Response is incomplete — please send again (a shorter request helps)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta incompleta — vuelve a enviarla (acortar la petición ayuda)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse incomplète — renvoie ta demande (plus courte, ça aide)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risposta incompleta — riprova a inviare (una richiesta più breve aiuta)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答が途中で切れました — もう一度送ってください（依頼を短くすると通りやすくなります）。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resposta incompleta — envia de novo (um pedido mais curto ajuda)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ неполный — отправь ещё раз (короткий запрос помогает)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复不完整 — 请重发（请求短一些会更好）。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब अधूरा है — कृपया दोबारा भेजें (छोटा सवाल मदद करता है)।"
          }
        },
        "bn": {
          "stringUnit": {
