        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिपबोर्ड में RTF/RTFD था (प्लेन टेक्स्ट नहीं)। इसे फिर से टेक्स्ट के रूप में कॉपी करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্লিপবোর্ড RTF/RTFD ছিল (প্লেইন টেক্সট নয়)। আবার টেক্সট হিসেবে কপি করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلپ بورڈ RTF/RTFD تھا (پلین ٹیکسٹ نہیں)۔ دوبارہ ٹیکسٹ کے طور پر کاپی کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard berupa RTF/RTFD (bukan teks biasa). Salin ulang sebagai teks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pano RTF/RTFD idi (düz metin değil). Tekrar metin olarak kopyalayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboard là RTF/RTFD (không phải văn bản thuần). Sao chép lại dưới dạng văn bản."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드가 RTF/RTFD였습니다 (일반 텍스트 아님). 다시 텍스트로 복사하세요."
          }
        }
      }
    },
    "[%@ hat kein Konto — unter Anbieter einen Key hinterlegen.]": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@ has no account — add a key under Providers.]"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@ no tiene cuenta — añade una clave en Proveedores.]"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@ n'a pas de compte — ajoute une clé sous Fournisseurs.]"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "[%@ não tem conta — introduz uma chave em Fornecedores.]"
          }
