    "Zwischenablage war RTF/RTFD (kein Klartext). Nochmal als Text kopieren.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحافظة كانت RTF/RTFD وليست نصًا عاديًا. انسخ المحتوى مرة أخرى كنص."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard held RTF/RTFD, not plain text. Copy it again as text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles tenía RTF/RTFD (no texto plano). Cópialo otra vez como texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers contenait du RTF/RTFD (pas de texte brut). Recopie-le en texte brut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli appunti contenevano RTF/RTFD (non testo semplice). Copia di nuovo come testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードが RTF/RTFD でした（プレーンテキストじゃない）。テキストとしてコピーし直してね。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de transferência tinha RTF/RTFD (sem texto simples). Copia outra vez como texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В буфере обмена был RTF/RTFD, а не обычный текст. Скопируй ещё раз как текст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板里是 RTF/RTFD（不是纯文本）。请重新复制为文本。"
          }
        }
      }
    },
