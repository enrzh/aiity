          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процесс завершили, а приложение этого не заметило."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنهيت العملية دون أن يلاحظ التطبيق ذلك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोसेस को बिना ऐप को पता चले समाप्त कर दिया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রসেস বন্ধ হয়েছে, অ্যাপ তা জানতে পারেনি।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پراسیس بند کر دیا گیا، ایپ کو پتہ نہیں چلا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses dihentikan tanpa diketahui aplikasi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süreç, uygulama fark etmeden sonlandırıldı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiến trình bị chấm dứt mà ứng dụng không nhận biết được."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 인지하지 못한 채 프로세스가 종료되었습니다."
          }
        }
      }
    },
    "Der bisherige Datenspeicher war unlesbar und wurde zur Seite gelegt. Ein Backup kannst du unten einspielen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old data store was unreadable and has been set aside. You can restore a backup below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacén de datos anterior era ilegible y se apartó. Abajo puedes restaurar un backup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ancien stockage de données était illisible et a été mis de côté. Tu peux restaurer un Backup ci-dessous."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento de dados anterior estava ilegível e foi posto de parte. Podes repor um Backup em baixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archivio dati precedente era illeggibile ed è stato messo da parte. Qui sotto puoi ripristinare un backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原来的数据存储无法读取，已被移到一边。你可以在下面恢复一个 Backup。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでのデータストアが読み取れなかったため、脇に退避しました。下から Backup を復元できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежнее хранилище данных не читалось и было отложено в сторону. Ниже можно восстановить данные из Backup."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزن البيانات السابق كان غير مقروء فوُضع جانبًا. يمكنك استعادة Backup من الأسفل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछला डेटा स्टोर पढ़ने योग्य नहीं था और उसे अलग रख दिया गया है। नीचे से आप बैकअप बहाल कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগের ডেটা স্টোর পড়া যাচ্ছিল না তাই আলাদা করে রাখা হয়েছে। নিচে একটি ব্যাকআপ পুনরুদ্ধার করতে পারেন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے کا ڈیٹا اسٹور پڑھا نہیں جا سکتا تھا اس لیے الگ رکھ دیا گیا۔ نیچے ایک بیک اپ بحال کیا جا سکتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan data sebelumnya tidak dapat dibaca dan telah disingkirkan. Anda dapat memulihkan backup di bawah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki veri deposu okunamadı ve bir kenara ayrıldı. Aşağıda bir yedek geri yükleyebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho dữ liệu trước đó không đọc được và đã được để riêng. Bạn có thể khôi phục một bản sao lưu bên dưới."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 데이터 저장소를 읽을 수 없어 별도로 보관했습니다. 아래에서 백업을 복원할 수 있습니다."
          }
        }
      }
    },
    "Der gespeicherte Bericht des letzten Laufs wird entfernt. Der aktuelle Lauf wird weiter aufgezeichnet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف التقرير المحفوظ لآخر تشغيل. أما التشغيل الحالي فيستمر تسجيله."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved report from the last run will be removed. The current run keeps being recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará el informe guardado de la última ejecución. La ejecución actual se sigue registrando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport enregistré de la dernière session sera supprimé. La session en cours continue d'être enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il report salvato dell'ultima esecuzione verrà rimosso. L'esecuzione attuale continua a essere registrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の実行の保存済みレポートを削除します。今の実行はそのまま記録され続けます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O relatório guardado da última execução será removido. A execução atual continua a ser registada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый отчёт о прошлом запуске будет удалён. Текущий запуск продолжит записываться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的上次运行报告将被删除。本次运行会继续记录。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले रन की सेव की गई रिपोर्ट हटा दी जाएगी। मौजूदा रन दर्ज होता रहेगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ রানের সংরক্ষিত রিপোর্ট মুছে ফেলা হবে। বর্তমান রান রেকর্ড হতেই থাকবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آخری رن کی محفوظ شدہ رپورٹ حذف ہو جائے گی۔ موجودہ رن ریکارڈ ہوتا رہے گا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan yang tersimpan dari sesi terakhir akan dihapus. Sesi saat ini akan terus direkam."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son oturumun kayıtlı raporu kaldırılacak. Mevcut oturum kaydedilmeye devam edecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo đã lưu của lần chạy cuối sẽ bị xóa. Lần chạy hiện tại sẽ tiếp tục được ghi lại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 실행의 저장된 보고서가 삭제됩니다. 현재 실행은 계속 기록됩니다."
          }
        }
      }
    },
    "Der normale Chat, der auch Mini-Apps baut.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدردشة العادية التي تبني Mini-Apps أيضًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The regular chat — it builds Mini-Apps too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat de siempre, el que también crea Mini-Apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat normal, celui qui crée aussi des Mini-Apps."
          }
        },
        "it": {
