    "Mini-Apps synchronisieren über deine Apple-ID. Kein Login in der App nötig.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتزامن Mini-Apps عبر Apple ID الخاص بك. لا حاجة لتسجيل دخول داخل التطبيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-Apps sync via your Apple ID. No login needed in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Mini-Apps se sincronizan con tu Apple ID. No hace falta iniciar sesión en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Mini-Apps se synchronisent via ton identifiant Apple. Aucune connexion nécessaire dans l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mini-App si sincronizzano tramite il tuo ID Apple. Nessun accesso richiesto nell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-App は Apple ID 経由で同期します。アプリ内でのログインは不要です。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As Mini-Apps sincronizam pelo teu ID Apple. Não é preciso iniciar sessão na app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-Apps синхронизируются через твой Apple ID. Вход в приложении не нужен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-Apps 通过你的 Apple ID 同步。无需在应用内登录。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-Apps आपकी Apple ID से सिंक होते हैं। ऐप में लॉगिन की ज़रूरत नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-Apps আপনার Apple ID দিয়ে সিঙ্ক হয়। অ্যাপে লগইনের দরকার নেই।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-Apps آپ کی Apple ID کے ذریعے سنک ہوتی ہیں۔ ایپ میں لاگ اِن کی ضرورت نہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-Apps disinkronkan melalui Apple ID Anda. Tidak perlu login di aplikasi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-App'ler Apple ID'niz üzerinden senkronize olur. Uygulamada giriş gerekmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-App đồng bộ qua Apple ID của bạn. Không cần đăng nhập trong ứng dụng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-App은 Apple ID를 통해 동기화됩니다. 앱 내 로그인이 필요 없습니다."
          }
        }
      }
    },
