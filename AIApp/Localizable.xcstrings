    "Im Hintergrund beendet — das ist normales iOS-Verhalten und kein Fehler.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ended while in the background — normal iOS behavior, not a bug."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminada en segundo plano — es el comportamiento normal de iOS, no un error."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtée en arrière-plan — c'est un comportement iOS normal, pas une erreur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminada em segundo plano — comportamento normal do iOS, não é um erro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminata in background — è il normale comportamento di iOS, non un errore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台被终止 — 这是 iOS 的正常行为，不是错误。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドで終了 — iOS の通常動作で、不具合ではありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершено в фоне — это нормальное поведение iOS, а не ошибка."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُنهي في الخلفية — سلوك عادي في iOS وليس خطأ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकग्राउंड में बंद हुआ — यह सामान्य iOS व्यवहार है, कोई गड़बड़ी नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকগ্রাউন্ডে বন্ধ হয়েছে — এটি স্বাভাবিক iOS আচরণ, কোনো ত্রুটি নয়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بیک گراؤنڈ میں بند ہوا — یہ عام iOS رویہ ہے، کوئی خرابی نہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditutup di latar belakang — ini perilaku normal iOS dan bukan kesalahan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planda kapatıldı — bu normal iOS davranışıdır, hata değildir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết thúc trong nền — đây là hành vi bình thường của iOS, không phải lỗi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서 종료됨 — 이는 정상적인 iOS 동작이며 오류가 아닙니다."
          }
        }
      }
    },
