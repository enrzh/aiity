    "Mehrere Konten möglich; das angehakte gilt für alle Nutzungsarten dieses Anbieters.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إضافة عدة حسابات؛ والحساب المحدَّد يُستخدم في كل استخدامات هذا المزوّد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add several accounts; the checked one is used everywhere this provider is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes tener varias cuentas; la marcada se usa para todo lo de este proveedor."
