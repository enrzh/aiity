          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " — Mini-App yang belum selesai berhasil diselamatkan, silakan periksa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " — eksik Mini-App kurtarıldı, lütfen kontrol edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": " — Mini-App chưa hoàn chỉnh đã được khôi phục, vui lòng kiểm tra."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " — 완료되지 않은 Mini-App이 복구되었습니다. 확인해 주세요."
