    "Kein API-Key / Abo-Login — unter KI-Anbieter ein Konto verbinden.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد مفتاح API أو تسجيل دخول بالاشتراك — اربط حسابًا من قسم المزوّدين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No API key / subscription login — connect an account under AI Providers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin API key ni acceso de suscripción — conecta una cuenta en Proveedores de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé API ni connexion abonnement — connecte un compte dans Fournisseurs IA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna chiave API / login abbonamento — collega un account in Provider IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーもサブスクログインもありません — AI プロバイダでアカウントを接続してね。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem chave API nem sessão de subscrição — liga uma conta em Fornecedores de IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет API-ключа или входа по подписке — подключи аккаунт в разделе «Провайдеры»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 API 密钥 / 订阅登录 — 请在 AI 服务商里连接一个账户。"
          }
        }
      }
    },
    "Kein Internet — Verbindung prüfen und erneut versuchen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد إنترنت — تحقق من الاتصال وأعد المحاولة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet — check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin internet — comprueba la conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'Internet — vérifie la connexion et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione a internet — controlla la rete e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネット接続なし — 接続を確認して、もう一度お試しください。"
          }
        },
        "pt": {
