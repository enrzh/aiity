    "Adresse deiner sub2api-Instanz (Host:Port). Das iPhone muss sie erreichen — im WLAN per LAN-IP, sonst über Tailscale/VPN.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان نسخة sub2api لديك (Host:Port). يجب أن يصل إليها iPhone — عبر عنوان الشبكة المحلية في الواي-فاي، أو عبر Tailscale/VPN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address of your sub2api instance (host:port). The iPhone has to reach it — by LAN IP on Wi-Fi, otherwise over Tailscale/VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección de tu instancia de sub2api (host:puerto). El iPhone tiene que poder acceder: por IP local en el wifi, o si no por Tailscale/VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse de ton instance sub2api (hôte:port). L'iPhone doit pouvoir l'atteindre — en Wi-Fi via l'IP locale, sinon par Tailscale/VPN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirizzo della tua istanza sub2api (host:porta). L'iPhone deve poterla raggiungere — in Wi-Fi tramite IP locale, altrimenti via Tailscale/VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sub2api インスタンスのアドレス（ホスト:ポート）。iPhone から到達できる必要があります — 同じ Wi-Fi なら LAN IP、それ以外は Tailscale／VPN 経由で。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Endereço da tua instância sub2api (host:porta). O iPhone tem de a alcançar — no Wi-Fi pelo IP local, caso contrário por Tailscale/VPN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес твоего sub2api (хост:порт). iPhone должен до него достучаться — в Wi-Fi по локальному IP, иначе через Tailscale/VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 sub2api 实例地址（主机:端口）。iPhone 必须能访问它 — 同一 Wi-Fi 下用局域网 IP，否则走 Tailscale/VPN。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने sub2api इंस्टेंस का पता (Host:Port)। iPhone को इस तक पहुँच होनी चाहिए — WLAN पर LAN-IP से, वरना Tailscale/VPN से।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার sub2api ইনস্ট্যান্সের ঠিকানা (Host:Port)। iPhone-কে এটি অ্যাক্সেস করতে হবে — WLAN-এ LAN-IP দিয়ে, নাহলে Tailscale/VPN দিয়ে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے sub2api انسٹینس کا پتہ (Host:Port)۔ iPhone کو اس تک رسائی ہونی چاہیے — WLAN میں LAN-IP کے ذریعے، ورنہ Tailscale/VPN کے ذریعے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat instans sub2api Anda (Host:Port). iPhone harus dapat mengaksesnya — melalui LAN-IP di WLAN, atau melalui Tailscale/VPN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "sub2api örneğinizin adresi (Host:Port). iPhone ona ulaşabilmeli — WLAN'da LAN-IP ile, aksi halde Tailscale/VPN ile."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ instance sub2api của bạn (Host:Port). iPhone phải truy cập được — qua LAN-IP trong WLAN, hoặc qua Tailscale/VPN."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "sub2api 인스턴스 주소 (Host:Port). iPhone이 접근할 수 있어야 합니다 — WLAN에서는 LAN-IP로, 그 외에는 Tailscale/VPN으로."
          }
        }
      }
    },
