            "value": "Сервер не вернул моделей (data[] пуст)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخادم لا يُبلّغ عن أي نماذج (data[] فارغة)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर कोई मॉडल नहीं दिखा रहा (data[] खाली)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্ভার কোনো মডেল দেখাচ্ছে না (data[] খালি)।"
