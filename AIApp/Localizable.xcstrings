    "Braucht einen eigenen Key bzw. Server. Ohne gültige Angaben fällt die Suche auf DuckDuckGo zurück.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج مفتاحاً أو خادماً خاصاً بك. وبدون بيانات صالحة يعود البحث إلى DuckDuckGo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs your own key or server. Without valid details, search falls back to DuckDuckGo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita una clave o un servidor propios. Sin datos válidos, la búsqueda vuelve a DuckDuckGo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite ta propre clé ou ton propre serveur. Sans informations valides, la recherche bascule sur DuckDuckGo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede una chiave o un server propri. Senza dati validi la ricerca torna a DuckDuckGo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のキーまたはサーバーが必要です。設定が正しくない場合、検索は DuckDuckGo に戻ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de uma chave ou servidor próprio. Sem dados válidos, a pesquisa recorre ao DuckDuckGo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен свой ключ или сервер. Без корректных данных поиск переключится на DuckDuckGo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你自己的密钥或服务器。信息不完整时，搜索会回退到 DuckDuckGo。"
          }
        }
      }
    },
