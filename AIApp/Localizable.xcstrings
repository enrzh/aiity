          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi avere più account; quello spuntato vale per tutti gli usi di questo provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは複数登録できます。チェックしたものが、このプロバイダのすべての用途に使われます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes ter várias contas; a que estiver marcada vale para todas as utilizações deste fornecedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
