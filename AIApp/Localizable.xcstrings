    "Lege Spezialisten an — der Chat fragt sie von sich aus, wenn eine Aufgabe passt.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ متخصّصين — والدردشة تسألهم من تلقاء نفسها عندما تناسبهم المهمة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create specialists — the chat asks them on its own when a task fits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea especialistas — el chat les pregunta por su cuenta cuando encajan con la tarea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée des spécialistes — le chat les consulte de lui-même quand une tâche s'y prête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea degli specialisti — la chat li interpella da sola quando un compito fa al caso loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "専門のエージェントを作っておくと、合う仕事のときチャットが自分から相談するよ。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria especialistas — o chat pergunta-lhes por iniciativa própria quando a tarefa encaixa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создай специалистов — чат сам их спросит, когда попадётся подходящая задача."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建专职智能体 — 遇到合适的任务，聊天会主动去问它们。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विशेषज्ञ बनाएँ — जब कोई काम मेल खाता है तो चैट खुद उनसे पूछता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিশেষজ্ঞ তৈরি করুন — কাজ মিলে গেলে চ্যাট নিজে থেকেই তাদের জিজ্ঞাসা করবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ماہرین بنائیں — کام مماثل ہونے پر چیٹ خود ان سے پوچھے گی۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat spesialis — chat akan bertanya sendiri jika ada tugas yang sesuai."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzmanlar oluşturun — bir görev uygun olduğunda sohbet kendiliğinden onlara sorar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo các chuyên gia — trò chuyện sẽ tự hỏi họ khi có nhiệm vụ phù hợp."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전문가를 만드세요 — 적합한 작업이 있으면 채팅이 스스로 물어봅니다."
          }
        }
      }
    },
