    "Diese Runde spricht nur mit den ersten %lld Agenten der Gruppe.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This round only talks to the first %lld agents in the group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ronda solo habla con los primeros %lld agentes del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tour ne s'adresse qu'aux %lld premiers agents du groupe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ronda fala só com os primeiros %lld agentes do grupo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo giro parla solo con i primi %lld agenti del gruppo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮只与群组中的前 %lld 个智能体对话。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このラウンドはグループの先頭 %lld エージェントとだけやりとりします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот раунд обращается только к первым %lld агентам группы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقتصر هذه الجولة على أول %lld من وكلاء المجموعة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह राउंड ग्रुप के पहले %lld Agents से ही बात करता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রাউন্ড শুধু গ্রুপের প্রথম %lld জন Agent-এর সাথে কথা বলবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ راؤنڈ صرف گروپ کے پہلے %lld Agents سے بات کرے گا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ronde ini hanya berbicara dengan %lld Agent pertama dalam grup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tur yalnızca gruptaki ilk %lld Agent ile konuşur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vòng này chỉ nói chuyện với %lld Agent đầu tiên trong nhóm."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 라운드는 그룹의 처음 %lld개 Agent와만 대화합니다."
          }
        }
      }
    },
    "Diesen Namen gibt es schon. Namen müssen eindeutig sein — der Chat spricht Agenten über den Namen an.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الاسم مستخدم بالفعل. يجب أن تكون الأسماء فريدة — فالدردشة تنادي الوكلاء بأسمائهم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That name is taken. Names have to be unique — the chat addresses agents by name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese nombre ya existe. Los nombres deben ser únicos: el chat se dirige a los agentes por su nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom existe déjà. Les noms doivent être uniques — le chat s'adresse aux agents par leur nom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo nome esiste già. I nomi devono essere univoci — la chat richiama gli agenti per nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前はすでに使われています。名前は重複できません — チャットは名前でエージェントを呼び出します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nome já existe. Os nomes têm de ser únicos — o chat trata os agentes pelo nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такое имя уже есть. Имена должны быть уникальными — чат обращается к агентам по имени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个名字已经有了。名字必须唯一 — 聊天要靠名字来点名智能体。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह नाम पहले से मौजूद है। नाम अलग-अलग होने चाहिए — चैट Agents को नाम से ही बुलाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নাম আগে থেকেই আছে। নাম অবশ্যই ইউনিক হতে হবে — চ্যাট নাম দিয়ে Agent-দের ডাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ نام پہلے سے موجود ہے۔ نام منفرد ہونے چاہئیں — چیٹ نام سے Agents کو مخاطب کرتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama ini sudah ada. Nama harus unik — chat memanggil Agent berdasarkan nama."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu isim zaten var. İsimler benzersiz olmalı — sohbet Agent'lara isimle hitap eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên này đã tồn tại. Tên phải là duy nhất — trò chuyện gọi Agent theo tên."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름은 이미 존재합니다. 이름은 고유해야 합니다 — 채팅은 이름으로 Agent를 부릅니다."
          }
        }
      }
    },
