    "iCloud ist ausgeschaltet. Deine Mini-Apps bleiben vollständig auf diesem Gerät.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud مُعطَّل. تبقى Mini-Apps بالكامل على هذا الجهاز."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is off. Your Mini-Apps stay entirely on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud está desactivado. Tus Mini-Apps se quedan íntegramente en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est désactivé. Tes Mini-Apps restent entièrement sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud è disattivato. Le tue Mini-App restano interamente su questo dispositivo."
          }
        },
        "ja": {
