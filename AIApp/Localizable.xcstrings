    "Ollama auf dem Mac: `ollama serve`, dann die LAN-IP dieses Macs hier eintragen (nicht localhost vom iPhone).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama على الـ Mac: `ollama serve`، ثم أدخل هنا عنوان الـ IP المحلي لهذا الـ Mac (وليس localhost من iPhone)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama on the Mac: `ollama serve`, then enter that Mac's LAN IP here (not localhost — you're on the iPhone)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama en el Mac: `ollama serve`, y luego pon aquí la IP local de ese Mac (no localhost desde el iPhone)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama sur le Mac : `ollama serve`, puis saisis ici l'IP locale de ce Mac (pas localhost depuis l'iPhone)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama sul Mac: `ollama serve`, poi inserisci qui l'IP locale del Mac (non localhost dall'iPhone)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac で Ollama を動かすなら `ollama serve` してから、その Mac の LAN IP をここに入力（iPhone からは localhost では届かない）。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama no Mac: `ollama serve` e depois introduz aqui o IP local desse Mac (não localhost a partir do iPhone)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama на Mac: `ollama serve`, потом впиши сюда LAN-IP этого Mac (не localhost — с iPhone он не работает)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上运行 Ollama：`ollama serve`，然后在这里填这台 Mac 的局域网 IP（iPhone 上用不了 localhost）。"
          }
        }
      }
    },
    "On-Device MLX unterstützt nur Chat, keine Bildgenerierung.": {
