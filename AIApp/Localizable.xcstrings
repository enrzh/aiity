    "Es liegt noch kein früherer Lauf vor.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد تشغيل سابق بعد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no earlier run yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ninguna ejecución anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore d'exécution précédente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è ancora nessuna esecuzione precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の実行はまだ記録されていません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nenhuma execução anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошлого запуска пока нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有上一次运行的记录。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई पिछला रन मौजूद नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো আগের রান নেই।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی پہلا رن موجود نہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada sesi sebelumnya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz önceki bir oturum yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có lần chạy trước đó."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 실행이 아직 없습니다."
          }
        }
      }
    },
    "Es läuft gerade eine Antwort — bitte kurz warten oder stoppen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك رد قيد التوليد — انتظر قليلاً أو أوقفه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A response is still coming in — wait a moment or stop it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una respuesta en curso — espera un momento o deténla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réponse est en cours — patiente un instant ou arrête-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è una risposta in corso — attendi un attimo o interrompila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答の生成中です — 少し待つか、停止してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Está a decorrer uma resposta — espera um pouco ou para."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ ещё генерируется — подожди немного или останови."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在生成回复 — 请稍等，或先停止。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी एक जवाब आ रहा है — कृपया थोड़ा इंतज़ार करें या रोकें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি উত্তর চলছে — দয়া করে একটু অপেক্ষা করুন বা থামান।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک جواب چل رہا ہے — براہ کرم تھوڑا انتظار کریں یا روکیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah jawaban sedang berlangsung — mohon tunggu sebentar atau hentikan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda bir yanıt üretiliyor — lütfen kısa süre bekleyin veya durdurun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang có một phản hồi diễn ra — vui lòng đợi một chút hoặc dừng lại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 응답이 진행 중입니다 — 잠시 기다리거나 중지하세요."
          }
        }
      }
    },
