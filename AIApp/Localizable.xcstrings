            "state": "translated",
            "value": "  (لا حقول أعطال في التقرير)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " (रिपोर्ट में क्रैश फ़ील्ड नहीं)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "  (রিপোর্টে ক্র্যাশ ফিল্ড নেই)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "  (رپورٹ میں کوئی کریش فیلڈ نہیں)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "  (tidak ada bidang crash di laporan)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "  (raporda çökme alanı yok)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "  (không có trường crash trong báo cáo)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "  (보고서에 크래시 필드 없음)"
          }
        }
