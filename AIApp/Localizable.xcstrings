          }
        }
      }
    },
    "Nur diese eine Nachricht — nicht die Unterhaltung, nicht deine Schlüssel. Es geht an %@; es gibt keinen aiity-Server, der das automatisch entgegennimmt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this one message — not the conversation, not your keys. It goes to %@; there's no aiity server that receives it automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo este mensaje — no la conversación, ni tus claves. Se envía a %@; no hay ningún servidor de aiity que lo reciba automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement ce message — pas la conversation, pas tes clés. Il part vers %@ ; il n'existe aucun serveur aiity qui le reçoive automatiquement."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só esta mensagem — não a conversa, nem as tuas chaves. Vai para %@; não existe nenhum servidor aiity que receba isto automaticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo questo messaggio — non la conversazione, non le tue chiavi. Viene inviato a %@; non esiste un server aiity che lo riceva automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只发送这一条消息 — 不含对话内容，也不含你的密钥。它会发给 %@；aiity 没有自动接收这些内容的服务器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送るのはこのメッセージ1件だけ — 会話全体でも、あなたのキーでもありません。送信先は %@ です。これを自動で受け取る aiity のサーバーはありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только это одно сообщение — не переписка и не твои ключи. Оно уйдёт к %@; сервера aiity, который принимал бы это автоматически, не существует."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الرسالة وحدها — وليس المحادثة ولا مفاتيحك. سترسل إلى %@؛ لا يوجد خادم aiity يستقبلها تلقائيًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ यही एक संदेश — पूरी बातचीत नहीं, आपके Keys नहीं। यह %@ को जाता है; कोई aiity सर्वर नहीं है जो इसे अपने आप ले लेता हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু এই একটি বার্তা — পুরো কথোপকথন নয়, আপনার Key নয়। এটি %@-এ যায়; এটি স্বয়ংক্রিয়ভাবে গ্রহণ করার জন্য কোনো aiity সার্ভার নেই।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف یہ ایک پیغام — پوری گفتگو نہیں، آپ کی Keys نہیں۔ یہ %@ کو جاتا ہے؛ اسے خودکار طور پر وصول کرنے والا کوئی aiity سرور نہیں ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pesan ini saja — bukan percakapan, bukan Key Anda. Ini dikirim ke %@; tidak ada server aiity yang menerimanya secara otomatis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece bu tek mesaj — tüm sohbet değil, Key'leriniz değil. %@'ye gider; bunu otomatik olarak alan bir aiity sunucusu yoktur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tin nhắn này thôi — không phải toàn bộ cuộc trò chuyện, không phải Key của bạn. Nó được gửi đến %@; không có server aiity nào tự động nhận nó."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메시지 하나만 — 전체 대화가 아니고, Key도 아닙니다. %@(으)로 전송됩니다; 이를 자동으로 수신하는 aiity 서버는 없습니다."
          }
        }
      }
    },
