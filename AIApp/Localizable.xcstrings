            "value": "Сохранённые данные в %@ не читаются. Копия отложена в сторону."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البيانات المحفوظة في %@ غير مقروءة. تم وضع نسخة جانبًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में सेव किया डेटा पढ़ने योग्य नहीं है। एक कॉपी अलग रख दी गई है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ সংরক্ষিত ডেটা পড়া যাচ্ছে না। একটি কপি আলাদা করে রাখা হয়েছে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ میں محفوظ ڈیٹا پڑھا نہیں جا سکتا۔ ایک کاپی الگ رکھ دی گئی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data tersimpan di %@ tidak dapat dibaca. Sebuah salinan telah disingkirkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'de kayıtlı veriler okunamıyor. Bir kopya bir kenara ayrıldı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu đã lưu trong %@ không đọc được. Một bản sao đã được để riêng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 저장된 데이터를 읽을 수 없습니다. 복사본을 별도로 보관했습니다."
          }
        }
      }
    },
