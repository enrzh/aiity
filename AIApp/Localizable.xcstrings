    "Sagt erst, was es vorhat, und wartet auf dein OK.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you the plan first and waits for your OK."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero dice qué va a hacer y espera tu OK."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonce d'abord ce qu'il compte faire et attend ton OK."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz primeiro o que vai fazer e espera pelo teu OK."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dice prima cosa ha in mente e aspetta il tuo OK."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先说打算怎么做，等你点头再动手。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やることを先に説明して、OK をもらってから進む。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала говорит, что собирается делать, и ждёт твоего OK."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخبرك أولًا بما ينوي فعله وينتظر موافقتك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले बताता है कि क्या करने वाला है, फिर आपके OK का इंतज़ार करता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমে কী করতে চায় তা বলে, তারপর আপনার OK-এর জন্য অপেক্ষা করে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے بتاتا ہے کیا کرنے والا ہے، پھر آپ کے OK کا انتظار کرتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyatakan dulu apa yang akan dilakukan, lalu menunggu persetujuan Anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce ne yapmayı planladığını söyler, sonra onayınızı bekler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nói trước điều nó dự định làm, rồi chờ sự đồng ý của bạn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 계획을 말한 후 승인을 기다립니다."
          }
        }
      }
    },
