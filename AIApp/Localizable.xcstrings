          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": " — Settings → muat model dan pilih model lain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " — Ayarlar → Modelleri yükle ve başka bir model seç."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": " — Cài đặt → tải mô hình và chọn mô hình khác."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " — 설정 → 모델 불러오기에서 다른 모델을 선택하세요."
          }
        }
      }
    },
