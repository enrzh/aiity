{
  "sourceLanguage": "de",
  "strings": {
    "         Symbolisieren nötig wäre. Der MetricKit-Bericht unten": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "         symbolication would require. The MetricKit report below"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "         que haría falta para simbolizar. El informe de MetricKit de abajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "         symbolisation exigerait. Le rapport MetricKit ci-dessous"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "         necessário para simbolizar. O relatório MetricKit abaixo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "         serve per simbolizzare. Il report MetricKit qui sotto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "         内存分配。下方的 MetricKit 报告"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "         メモリ確保が一切できないためです。下の MetricKit レポートには"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "         нужно для символизации. Отчёт MetricKit ниже"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "         للرمزنة. تقرير MetricKit أدناه"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "         सिंबलीकरण के लिए ज़रूरी होगी। नीचे दी गई MetricKit रिपोर्ट"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "         সিম্বলাইজ করা প্রয়োজন হত। নিচের MetricKit রিপোর্ট"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "         سمبلائز کرنے کی ضرورت ہوتی۔ نیچے دی گئی MetricKit رپورٹ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "         perlu symbolisasi. Laporan MetricKit di bawah"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "         sembolleştirme gerekirdi. Aşağıdaki MetricKit raporu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "         cần được ký hiệu hóa. Báo cáo MetricKit bên dưới"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "         심볼화가 필요했을 것입니다. 아래 MetricKit 보고서는"
          }
        }
      }
    },
    "         der Signal-Handler darf nichts allozieren, was zum": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "         the signal handler must not allocate anything, which"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "         el manejador de señales no puede reservar memoria, que es lo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "         le gestionnaire de signal ne peut rien allouer, ce que la"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "         o handler de sinal não pode alocar nada do que é"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "         il gestore del segnale non può allocare ciò che"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "         信号处理器不能进行符号化所需的"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "         シグナルハンドラ内では、シンボル化に必要な"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "         обработчик сигнала не может ничего выделять, а это"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "         معالج الإشارة لا يجوز له حجز ذاكرة، وهي لازمة"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "         सिग्नल हैंडलर कुछ भी आबंटित नहीं कर सकता, जो"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "         সিগন্যাল-হ্যান্ডলার এমন কিছু বরাদ্দ করতে পারে না যা"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "         سگنل ہینڈلر کچھ بھی allocate نہیں کر سکتا جو"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "         signal handler tidak boleh mengalokasikan apa pun yang dapat menyebabkan"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "         sinyal işleyicisi hiçbir şey ayıramaz, bu da şuna yol açar:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "         signal handler không được cấp phát bất cứ thứ gì dẫn đến"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "         시그널 핸들러는 어떤 것도 할당할 수 없으며, 이는"
          }
        }
      }
    },
    "         liefert dieselben Frames mit Namen, sobald iOS ihn ausliefert):": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "         shows the same frames with names once iOS delivers it):"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "         entrega los mismos frames con nombre en cuanto iOS lo publique):"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "         donne les mêmes frames avec leurs noms, dès qu'iOS le fournit) :"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "         dá os mesmos frames com nomes, assim que o iOS o entregar):"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "         mostra gli stessi frame con i nomi, appena iOS lo fornisce):"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "         会在 iOS 提供后给出同样的堆栈帧，并带上名称）："
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "         iOS が出力し次第、同じフレームが名前付きで載ります）:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "         покажет те же кадры с именами, как только iOS его выдаст):"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "         يعطي نفس الإطارات بأسمائها بمجرّد أن يوفّره iOS):"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "         iOS द्वारा उपलब्ध कराते ही वही फ़्रेम नामों के साथ देती है):"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "         iOS দেওয়ার সাথে সাথে একই ফ্রেম নাম সহ দেয়):"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "         iOS کے فراہم کرتے ہی وہی فریمز نام کے ساتھ دیتی ہے):"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "         memberikan frame yang sama dengan nama begitu iOS menyediakannya):"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "         iOS onu sağlar sağlamaz aynı çerçeveleri isimlerle verir):"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "         cung cấp cùng các khung với tên ngay khi iOS gửi nó):"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "         iOS가 제공하는 즉시 동일한 프레임을 이름과 함께 제공합니다):"
          }
        }
      }
    },
    "  (keine Absturzfelder im Bericht)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "  (no crash fields in the report)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "  (sin campos de fallo en el informe)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "  (aucun champ de crash dans le rapport)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "  (sem campos de falha no relatório)"
          }
        },
        "it": {
