    "Mehrere Konten möglich; das angehakte gilt für alle Nutzungsarten dieses Anbieters.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إضافة عدة حسابات؛ والحساب المحدَّد يُستخدم في كل استخدامات هذا المزوّد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add several accounts; the checked one is used everywhere this provider is used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes tener varias cuentas; la marcada se usa para todo lo de este proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs comptes possibles ; celui qui est coché vaut pour tous les usages de ce fournisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi avere più account; quello spuntato vale per tutti gli usi di questo provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは複数登録できます。チェックしたものが、このプロバイダのすべての用途に使われます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes ter várias contas; a que estiver marcada vale para todas as utilizações deste fornecedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунтов может быть несколько; отмеченный используется для всех задач этого провайдера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以添加多个账户；打勾的那个用于该服务商的所有用途。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई खाते संभव हैं; चुना हुआ खाता इस प्रोवाइडर के हर उपयोग पर लागू होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একাধিক অ্যাকাউন্ট সম্ভব; চেক করা অ্যাকাউন্টটি এই প্রোভাইডারের সব ব্যবহারের জন্য প্রযোজ্য।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "متعدد اکاؤنٹس ممکن ہیں؛ نشان زدہ اکاؤنٹ اس فراہم کنندہ کے تمام استعمال کے لیے لاگو ہوتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa akun dimungkinkan; yang dicentang berlaku untuk semua jenis penggunaan penyedia ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla hesap mümkün; işaretli olan bu sağlayıcının tüm kullanım türleri için geçerlidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể dùng nhiều tài khoản; tài khoản được đánh dấu áp dụng cho mọi cách sử dụng nhà cung cấp này."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 계정이 가능합니다; 체크된 계정이 이 제공자의 모든 사용 방식에 적용됩니다."
          }
        }
      }
    },
