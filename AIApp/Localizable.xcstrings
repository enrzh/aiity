    "iCloud gleicht gerade ab — deine Apps von anderen Geräten sollten gleich erscheinen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is syncing — your apps from other devices should appear in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud se está sincronizando: tus apps de otros dispositivos deberían aparecer enseguida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud synchronise — tes apps des autres appareils devraient apparaître dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud si sta sincronizzando — le tue app sugli altri dispositivi dovrebbero comparire a breve."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está a sincronizar — as tuas apps de outros dispositivos devem aparecer em breve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud が同期中です — 他のデバイスのアプリはまもなく表示されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud синхронизируется — приложения с других устройств скоро появятся."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنة iCloud — يجب أن تظهر تطبيقاتك من الأجهزة الأخرى خلال لحظات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 正在同步 — 你在其他设备上的 App 很快就会出现。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud अभी सिंक कर रहा है — दूसरे डिवाइसों के आपके Apps जल्द ही दिखने चाहिए।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud এখন সিঙ্ক করছে — অন্য ডিভাইসের আপনার Apps শীঘ্রই দেখা যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud اب سنک کر رہا ہے — دوسرے ڈیوائسز کی آپ کی Apps جلد ظاہر ہونی چاہئیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sedang menyinkronkan — Apps Anda dari perangkat lain akan segera muncul."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud şu anda senkronize ediyor — diğer cihazlardaki App'leriniz kısa süre içinde görünmeli."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud đang đồng bộ — App của bạn từ các thiết bị khác sẽ sớm xuất hiện."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud가 현재 동기화 중입니다 — 다른 기기의 App이 곧 나타날 것입니다."
          }
        }
      }
    },
    "iCloud ist ausgeschaltet. Deine Mini-Apps bleiben vollständig auf diesem Gerät.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud مُعطَّل. تبقى Mini-Apps بالكامل على هذا الجهاز."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is off. Your Mini-Apps stay entirely on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud está desactivado. Tus Mini-Apps se quedan íntegramente en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est désactivé. Tes Mini-Apps restent entièrement sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud è disattivato. Le tue Mini-App restano interamente su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud はオフです。Mini-App はすべてこの端末内だけに残ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está desligado. As tuas Mini-Apps ficam apenas neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud выключен. Твои Mini-Apps остаются только на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 已关闭。你的 Mini-Apps 完全保存在本机。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud बंद है। आपके Mini-Apps पूरी तरह इसी डिवाइस पर रहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud বন্ধ আছে। আপনার Mini-Apps সম্পূর্ণভাবে এই ডিভাইসেই থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud بند ہے۔ آپ کی Mini-Apps مکمل طور پر اسی ڈیوائس پر رہتی ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud dimatikan. Mini-Apps Anda sepenuhnya tetap di perangkat ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud kapalı. Mini-App'leriniz tamamen bu cihazda kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud đang tắt. Mini-App của bạn hoàn toàn ở lại trên thiết bị này."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud가 꺼져 있습니다. Mini-App은 완전히 이 기기에만 남아 있습니다."
          }
        }
      }
    },
