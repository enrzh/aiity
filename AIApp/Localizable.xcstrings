    "API-Key — Standard Chat Completions (api.openai.com). Nach „Modelle laden“ ein verfügbares Modell wählen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح API — Chat Completions القياسي (api.openai.com). بعد «تحميل النماذج» اختر نموذجاً متاحاً."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key — standard Chat Completions (api.openai.com). After “Load models”, pick an available model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave API — Chat Completions estándar (api.openai.com). Tras “Cargar modelos”, elige un modelo disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé API — Chat Completions standard (api.openai.com). Après « Charger les modèles », choisis un modèle disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave API — Chat Completions standard (api.openai.com). Dopo «Carica modelli» scegli un modello disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キー — 標準の Chat Completions（api.openai.com）。「モデルを読み込む」のあと、使えるモデルを選んでください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chave API — Chat Completions padrão (api.openai.com). Depois de «Carregar modelos», escolhe um modelo disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "API-ключ — стандартный Chat Completions (api.openai.com). После «Загрузить модели» выбери доступную модель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥 — 标准 Chat Completions（api.openai.com）。点“加载模型”后再选一个可用模型。"
          }
        }
      }
    },
