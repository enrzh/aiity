    "Kein iCloud-Sync — melde dich in den iOS-Einstellungen bei iCloud an, oder aktiviere iCloud Drive. Deine Daten bleiben lokal erhalten.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No iCloud sync — sign in to iCloud in iOS Settings, or turn on iCloud Drive. Your data stays on the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin sincronización con iCloud — inicia sesión en iCloud en los Ajustes de iOS o activa iCloud Drive. Tus datos se conservan en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de synchro iCloud — connecte-toi à iCloud dans les réglages iOS, ou active iCloud Drive. Tes données restent conservées en local."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem sincronização com o iCloud — inicia sessão no iCloud nas Definições do iOS ou ativa o iCloud Drive. Os teus dados continuam guardados localmente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna sincronizzazione iCloud — accedi a iCloud nelle impostazioni di iOS oppure attiva iCloud Drive. I tuoi dati restano salvati in locale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 iCloud 同步 — 请在 iOS 设置里登录 iCloud，或打开 iCloud Drive。你的数据仍会保存在本地。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同期なし — iOS の設定で iCloud にサインインするか、iCloud Drive をオンにしてください。データは端末内にそのまま残ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет синхронизации с iCloud — войди в iCloud в настройках iOS или включи iCloud Drive. Твои данные останутся на устройстве."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مزامنة iCloud — سجّل الدخول إلى iCloud في إعدادات iOS، أو فعّل iCloud Drive. بياناتك تبقى محفوظة محليًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई iCloud सिंक नहीं — iOS सेटिंग्स में iCloud में साइन-इन करें, या iCloud Drive चालू करें। आपका डेटा डिवाइस पर ही रहता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো iCloud সিঙ্ক নেই — iOS Settings-এ iCloud-এ সাইন ইন করুন, বা iCloud Drive চালু করুন। আপনার ডেটা লোকালি সুরক্ষিত থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی iCloud سنک نہیں — iOS Settings میں iCloud میں سائن اِن کریں، یا iCloud Drive فعال کریں۔ آپ کا ڈیٹا لوکل طور پر محفوظ رہتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada sinkronisasi iCloud — masuk ke iCloud di Settings iOS, atau aktifkan iCloud Drive. Data Anda tetap tersimpan secara lokal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud senkronizasyonu yok — iOS Ayarlar'da iCloud'a giriş yapın veya iCloud Drive'ı etkinleştirin. Verileriniz yerel olarak korunur."
          }
        },
        "vi": {
