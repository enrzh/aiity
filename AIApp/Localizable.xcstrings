    "Es liegt noch kein früherer Lauf vor.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد تشغيل سابق بعد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no earlier run yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ninguna ejecución anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore d'exécution précédente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è ancora nessuna esecuzione precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の実行はまだ記録されていません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nenhuma execução anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошлого запуска пока нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有上一次运行的记录。"
          }
        }
      }
    },
    "Es läuft gerade eine Antwort — bitte kurz warten oder stoppen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك رد قيد التوليد — انتظر قليلاً أو أوقفه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A response is still coming in — wait a moment or stop it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una respuesta en curso — espera un momento o deténla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réponse est en cours — patiente un instant ou arrête-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è una risposta in corso — attendi un attimo o interrompila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答の生成中です — 少し待つか、停止してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Está a decorrer uma resposta — espera um pouco ou para."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ ещё генерируется — подожди немного или останови."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在生成回复 — 请稍等，或先停止。"
          }
        }
      }
    },
