    "Verbindung unterbrochen — Netz prüfen und erneut senden.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال — تحقق من الشبكة وأعد الإرسال."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection dropped — check your connection and send again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión interrumpida — comprueba la red y vuelve a enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion interrompue — vérifie le réseau et renvoie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione interrotta — controlla la rete e riprova a inviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切れました — 通信を確認して再送してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligação interrompida — verifica a rede e envia de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение прервано — проверь сеть и отправь ещё раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接中断 — 请检查网络后重发。"
          }
        }
      }
    },
    "Verbindung unterbrochen — WLAN/Mobilfunk prüfen und erneut senden. Bei langen Antworten: App im Vordergrund lassen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع الاتصال — تحقق من الواي-فاي/بيانات الجوال وأعد الإرسال. مع الردود الطويلة: أبقِ التطبيق مفتوحاً في المقدمة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection dropped — check Wi-Fi/cellular and send again. For long answers, keep the app in the foreground."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión interrumpida: comprueba el wifi o los datos móviles y vuelve a enviar. Con respuestas largas, deja la app en primer plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion interrompue — vérifie le Wi-Fi ou le réseau mobile et renvoie. Pour les réponses longues : garde l'app au premier plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione interrotta — controlla Wi-Fi/rete mobile e riprova a inviare. Per risposte lunghe: tieni l'app in primo piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切れました — Wi-Fi／モバイル通信を確認して再送してください。長い応答のときはアプリを前面のままにしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligação interrompida — verifica o Wi-Fi/dados móveis e envia de novo. Em respostas longas: mantém a app em primeiro plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение прервано — проверь Wi-Fi или мобильную сеть и отправь ещё раз. При долгих ответах держи приложение открытым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接中断 — 请检查 Wi-Fi/移动网络后重发。回复较长时：让应用保持在前台。"
          }
        }
      }
    },
