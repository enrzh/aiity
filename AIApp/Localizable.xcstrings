    "Speicherdruck ist unwahrscheinlich — es gab keine Speicherwarnung.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory pressure is unlikely — there was no memory warning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La presión de memoria es improbable — no hubo ningún aviso de memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pression mémoire est peu probable — il n'y a eu aucun avertissement mémoire."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressão de memória improvável — não houve nenhum aviso de memória."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione sulla memoria improbabile — non c'è stato nessun avviso di memoria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不太可能是内存压力 — 没有出现过内存警告。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリ不足が原因の可能性は低い — メモリ警告は出ていません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нехватка памяти маловероятна — предупреждений о памяти не было."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضغط الذاكرة مستبعد — لم يصدر أي تحذير ذاكرة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेमोरी दबाव की संभावना नहीं — कोई मेमोरी चेतावनी नहीं मिली।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেমরি চাপের সম্ভাবনা কম — কোনো মেমরি সতর্কতা ছিল না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میموری دباؤ کا امکان نہیں — کوئی میموری وارننگ نہیں تھی۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekanan memori tidak mungkin — tidak ada peringatan memori."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bellek baskısı olası değil — bellek uyarısı yoktu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp lực bộ nhớ khó xảy ra — không có cảnh báo bộ nhớ nào."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 압박 가능성 낮음 — 메모리 경고가 없었습니다."
          }
        }
      }
    },
