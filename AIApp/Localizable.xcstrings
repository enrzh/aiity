    "Rechenfehler — Division durch null oder Überlauf.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ حسابي — قسمة على صفر أو تجاوز في السعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arithmetic error — division by zero or overflow."
          }
        },
        "es": {
