    "Server nicht erreichbar — IP/Port prüfen. Ist das iPhone im selben WLAN wie der Server, oder per Tailscale/VPN verbunden?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم — تحقق من IP/المنفذ. هل iPhone على نفس شبكة الخادم، أو متصل عبر Tailscale/VPN؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the server — check IP and port. Is the iPhone on the same Wi-Fi as the server, or connected over Tailscale/VPN?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder al servidor — comprueba la IP y el puerto. ¿Está el iPhone en el mismo wifi que el servidor o conectado por Tailscale/VPN?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveur injoignable — vérifie l'IP et le port. L'iPhone est-il sur le même Wi-Fi que le serveur, ou connecté via Tailscale/VPN ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Server non raggiungibile — controlla IP e porta. L'iPhone è sulla stessa rete Wi-Fi del server o collegato via Tailscale/VPN?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できません — IP とポートを確認してください。iPhone はサーバーと同じ Wi-Fi、または Tailscale／VPN でつながっていますか？"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidor inacessível — verifica o IP/porta. O iPhone está no mesmo Wi-Fi que o servidor ou ligado por Tailscale/VPN?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер недоступен — проверь IP и порт. iPhone в той же Wi-Fi-сети, что и сервер, или подключён через Tailscale/VPN?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上服务器 — 请检查 IP/端口。iPhone 和服务器在同一个 Wi-Fi 里吗？或者通过 Tailscale/VPN 连着吗？"
          }
        }
      }
    },
