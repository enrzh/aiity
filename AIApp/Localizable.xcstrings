    "Lädt die Modell-Liste und sendet einen kurzen Test-Chat. Fehler werden klar angezeigt — kein stilles Scheitern.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحمّل قائمة النماذج ويرسل دردشة اختبار قصيرة. تظهر الأخطاء بوضوح — بلا فشل صامت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loads the model list and sends a short test chat. Errors are shown plainly — nothing fails silently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga la lista de modelos y envía un chat de prueba corto. Los errores se muestran con claridad, nada falla en silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge la liste des modèles et envoie un court chat de test. Les erreurs s'affichent clairement — pas d'échec silencieux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica l'elenco dei modelli e invia una breve chat di prova. Gli errori vengono mostrati chiaramente — niente fallimenti silenziosi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル一覧を取得し、短いテストチャットを送ります。エラーははっきり表示されます — 黙って失敗することはありません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega a lista de modelos e envia um chat de teste curto. Os erros aparecem de forma clara — nada falha em silêncio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает список моделей и отправляет короткое тестовое сообщение. Ошибки показываются явно — без тихих сбоев."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会加载模型列表并发一条简短的测试消息。出错会明确提示 — 不会悄悄失败。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल सूची लोड करता है और एक छोटी टेस्ट चैट भेजता है। त्रुटियाँ साफ़ दिखाई जाती हैं — चुपचाप विफल नहीं होता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মডেল তালিকা লোড করে এবং একটি ছোট টেস্ট চ্যাট পাঠায়। ত্রুটি স্পষ্টভাবে দেখানো হয় — নীরব ব্যর্থতা নয়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ماڈل فہرست لوڈ کرتا ہے اور ایک مختصر ٹیسٹ چیٹ بھیجتا ہے۔ خرابیاں واضح طور پر دکھائی جاتی ہیں — خاموش ناکامی نہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memuat daftar model dan mengirim chat uji singkat. Kesalahan ditampilkan dengan jelas — tidak ada kegagalan diam-diam."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model listesini yükler ve kısa bir test sohbeti gönderir. Hatalar açıkça gösterilir — sessiz başarısızlık yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải danh sách mô hình và gửi một cuộc trò chuyện thử ngắn. Lỗi được hiển thị rõ ràng — không thất bại âm thầm."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 목록을 불러오고 짧은 테스트 채팅을 보냅니다. 오류는 명확하게 표시됩니다 — 조용한 실패는 없습니다."
          }
        }
      }
    },
