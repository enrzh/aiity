    "Nur das Bild-Modell für generate_image. Unabhängig vom Chat-Modell.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نموذج الصور لـ generate_image فقط. مستقل عن نموذج الدردشة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just the image model for generate_image. Independent of the chat model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el modelo de imagen para generate_image. Independiente del modelo de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement le modèle d'image pour generate_image. Indépendant du modèle de chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo il modello immagini per generate_image. Indipendente dal modello della chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "generate_image で使う画像モデルだけです。チャットのモデルとは別に選べます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o modelo de imagem para generate_image. Independente do modelo de chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только модель изображений для generate_image. Не зависит от модели чата."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于 generate_image 的图片模型，与聊天模型无关。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ generate_image के लिए इमेज मॉडल। चैट मॉडल से अलग।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু generate_image-এর জন্য ইমেজ মডেল। চ্যাট মডেল থেকে স্বতন্ত্র।"
          }
        },
        "ur": {
          "stringUnit": {
