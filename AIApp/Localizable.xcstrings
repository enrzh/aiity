    "Übersetzt Texte natürlich statt wörtlich, behält Ton und Fachbegriffe bei und markiert Stellen, die im Original mehrdeutig sind.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يترجم النصوص بأسلوب طبيعي لا حرفي، يحافظ على النبرة والمصطلحات، ويشير إلى المواضع الغامضة في الأصل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translates naturally rather than literally, keeps the tone and the terminology, and flags anything that's ambiguous in the original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce con naturalidad en vez de literalmente, mantiene el tono y los términos técnicos y señala los pasajes ambiguos del original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduit les textes de façon naturelle plutôt que littérale, conserve le ton et les termes techniques et signale les passages ambigus dans l'original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce in modo naturale invece che letterale, mantiene tono e termini tecnici e segnala i punti ambigui nell'originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直訳ではなく自然に訳し、トーンと専門用語を保ちます。原文があいまいな箇所は明示します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduz de forma natural em vez de literal, mantém o tom e os termos técnicos e assinala as passagens ambíguas no original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводит естественно, а не дословно, сохраняет тон и терминологию и отмечает места, двусмысленные в оригинале."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译力求地道而非逐字直译，保留语气和专业术语，并标出原文里含义模糊的地方。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट का शब्द-दर-शब्द नहीं, बल्कि स्वाभाविक अनुवाद करता है, लहज़ा और तकनीकी शब्द बनाए रखता है, और मूल में अस्पष्ट जगहों को चिह्नित करता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টেক্সট আক্ষরিক নয়, স্বাভাবিকভাবে অনুবাদ করে, সুর ও পরিভাষা বজায় রাখে এবং মূলে অস্পষ্ট স্থান চিহ্নিত করে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "متن کا لفظی نہیں بلکہ فطری ترجمہ کرتا ہے، لہجہ اور اصطلاحات برقرار رکھتا ہے، اور اصل میں مبہم جگہوں کی نشاندہی کرتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menerjemahkan teks secara natural, bukan harfiah, mempertahankan nada dan istilah teknis, serta menandai bagian yang ambigu dalam teks asli."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metinleri kelimesi kelimesine değil doğal şekilde çevirir, tonu ve terimleri korur ve orijinalde belirsiz olan yerleri işaretler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch văn bản một cách tự nhiên thay vì theo nghĩa đen, giữ giọng điệu và thuật ngữ chuyên môn, đánh dấu những chỗ mơ hồ trong bản gốc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트를 직역이 아닌 자연스럽게 번역하고, 어조와 전문 용어를 유지하며, 원문에서 모호한 부분을 표시합니다."
          }
        }
      }
    },
