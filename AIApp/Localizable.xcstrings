          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-Apps sync via your Apple ID. No login needed in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las Mini-Apps se sincronizan con tu Apple ID. No hace falta iniciar sesión en la app."
          }
        },
        "fr": {
          "stringUnit": {
