    "Ungültiger Speicherzugriff — Zugriff auf bereits freigegebenen Speicher.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصول غير صالح للذاكرة — استخدام ذاكرة سبق تحريرها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid memory access — used memory that was already freed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso a memoria no válido: acceso a memoria ya liberada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès mémoire invalide — accès à de la mémoire déjà libérée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso alla memoria non valido — accesso a memoria già liberata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不正なメモリアクセス — 解放済みメモリへのアクセスです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso inválido à memória — acesso a memória já libertada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недопустимое обращение к памяти — доступ к уже освобождённой памяти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非法内存访问 — 访问了已释放的内存。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमान्य मेमोरी एक्सेस — पहले ही मुक्त की गई मेमोरी का उपयोग।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবৈধ মেমরি অ্যাক্সেস — ইতিমধ্যে মুক্ত করা মেমরিতে অ্যাক্সেস।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "غلط میموری رسائی — پہلے سے آزاد کی گئی میموری تک رسائی۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses memori tidak valid — akses ke memori yang sudah dibebaskan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz bellek erişimi — zaten serbest bırakılmış belleğe erişim."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truy cập bộ nhớ không hợp lệ — truy cập vào bộ nhớ đã được giải phóng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효하지 않은 메모리 접근 — 이미 해제된 메모리에 대한 접근."
          }
        }
      }
    },
    "Unverschlüsseltes HTTP ist nur für eigene Server im lokalen Netz erlaubt — %@ ist öffentlich erreichbar. Nutze https://.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unencrypted HTTP is only allowed for your own servers on the local network — %@ is publicly reachable. Use https://."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP sin cifrar solo se permite con servidores propios en la red local — %@ es accesible públicamente. Usa https://."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le HTTP non chiffré n'est autorisé que pour tes propres serveurs sur le réseau local — %@ est accessible publiquement. Utilise https://."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP sem encriptação só é permitido para servidores teus na rede local — %@ está acessível publicamente. Usa https://."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'HTTP non cifrato è consentito solo per i tuoi server nella rete locale — %@ è raggiungibile pubblicamente. Usa https://."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未加密的 HTTP 只允许用于本地网络里你自己的服务器 — %@ 是公网可访问的。请用 https://。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化なしの HTTP はローカルネットワーク上の自分のサーバーにだけ許可されます — %@ は外部から到達できます。https:// を使ってください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Незашифрованный HTTP разрешён только для своих серверов в локальной сети — %@ доступен извне. Используй https://."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP غير المشفّر مسموح فقط لخوادمك على الشبكة المحلية — %@ متاح للعامة. استخدم https://."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना एन्क्रिप्शन वाला HTTP सिर्फ़ लोकल नेटवर्क में अपने सर्वर के लिए मान्य है — %@ सार्वजनिक रूप से पहुँच योग्य है। https:// इस्तेमाल करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এনক্রিপশন ছাড়া HTTP শুধু লোকাল নেটওয়ার্কে নিজস্ব সার্ভারের জন্য অনুমোদিত — %@ সর্বজনীনভাবে অ্যাক্সেসযোগ্য। https:// ব্যবহার করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بغیر انکرپشن HTTP صرف لوکل نیٹ ورک میں اپنے سرور کے لیے اجازت ہے — %@ عوامی طور پر قابلِ رسائی ہے۔ https:// استعمال کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP tanpa enkripsi hanya diizinkan untuk server sendiri di jaringan lokal — %@ dapat diakses secara publik. Gunakan https://."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifrelenmemiş HTTP yalnızca yerel ağdaki kendi sunucunuz için izinlidir — %@ herkese açık olarak erişilebilir. https:// kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP không mã hóa chỉ được phép cho server riêng trong mạng cục bộ — %@ có thể truy cập công khai. Dùng https://."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화되지 않은 HTTP는 로컬 네트워크의 자체 서버에만 허용됩니다 — %@은(는) 공개적으로 접근 가능합니다. https://를 사용하세요."
          }
        }
      }
    },
