          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "precondition thất bại, hoặc tràn số học."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "precondition 실패, 또는 산술 오버플로우."
          }
        }
      }
    },
