    },
    "Der Agent nutzt denselben Anbieter wie der Chat. Änderst du den Chat-Anbieter, zieht der Agent mit.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم الوكيل نفس مزوّد الدردشة. وإذا غيّرت مزوّد الدردشة، يتغيّر معه الوكيل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent uses the same provider as the chat. Change the chat provider and the agent follows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente usa el mismo proveedor que el chat. Si cambias el proveedor del chat, el agente cambia con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'agent utilise le même fournisseur que le chat. Si tu changes celui du chat, l'agent suit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'agente usa lo stesso provider della chat. Se cambi il provider della chat, l'agente lo segue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはチャットと同じプロバイダを使います。チャット側を変えると、エージェントも一緒に変わります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente usa o mesmo fornecedor que o chat. Se mudares o fornecedor do chat, o agente acompanha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент использует того же провайдера, что и чат. Сменишь провайдера чата — агент перейдёт следом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该智能体使用和聊天相同的服务商。你换了聊天的服务商，它也跟着换。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent चैट वाला ही प्रोवाइडर इस्तेमाल करता है। चैट प्रोवाइडर बदलने पर Agent भी उसी के साथ बदल जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent চ্যাটের মতো একই প্রোভাইডার ব্যবহার করে। চ্যাটের প্রোভাইডার বদলালে Agent-ও বদলে যায়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent چیٹ جیسا ہی فراہم کنندہ استعمال کرتا ہے۔ چیٹ کا فراہم کنندہ بدلنے پر Agent بھی بدل جاتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent menggunakan penyedia yang sama dengan chat. Jika Anda mengubah penyedia chat, Agent akan ikut berubah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent, sohbetle aynı sağlayıcıyı kullanır. Sohbet sağlayıcısını değiştirirseniz Agent da değişir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent dùng cùng nhà cung cấp với trò chuyện. Nếu bạn đổi nhà cung cấp của trò chuyện, Agent cũng sẽ đổi theo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent는 채팅과 동일한 제공자를 사용합니다. 채팅 제공자를 변경하면 Agent도 함께 변경됩니다."
          }
        }
      }
    },
    "Der Bericht enthält Gerätemodell, iOS-Version, App-Version, Anbietername und die Ereignisliste. Keine Nachrichteninhalte, keine API-Schlüssel.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتضمّن التقرير طراز الجهاز وإصدار iOS وإصدار التطبيق واسم المزوّد وقائمة الأحداث. بلا محتوى رسائل وبلا مفاتيح API."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report contains the device model, iOS version, app version, provider name and the event list. No message content, no API keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El informe incluye el modelo del dispositivo, la versión de iOS, la versión de la app, el nombre del proveedor y la lista de eventos. Ningún contenido de mensajes ni claves API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport contient le modèle d'appareil, la version d'iOS, la version de l'app, le nom du fournisseur et la liste des événements. Aucun contenu de message, aucune clé API."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rapporto contiene modello del dispositivo, versione di iOS, versione dell'app, nome del provider e l'elenco degli eventi. Nessun contenuto dei messaggi, nessuna chiave API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートに含まれるのは端末モデル、iOS バージョン、アプリバージョン、プロバイダ名、イベント一覧です。メッセージの内容や API キーは含みません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O relatório contém o modelo do dispositivo, a versão do iOS, a versão da app, o nome do fornecedor e a lista de eventos. Sem conteúdo de mensagens e sem chaves API."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В отчёт входят модель устройства, версия iOS, версия приложения, имя провайдера и список событий. Ни текстов сообщений, ни API-ключей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告包含设备型号、iOS 版本、应用版本、服务商名称和事件列表。不含消息内容，也不含 API 密钥。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट में डिवाइस मॉडल, iOS वर्शन, ऐप वर्शन, प्रोवाइडर का नाम और घटनाओं की सूची होती है। कोई संदेश सामग्री नहीं, कोई API-Key नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রিপোর্টে ডিভাইস মডেল, iOS ভার্সন, অ্যাপ ভার্সন, প্রোভাইডারের নাম ও ঘটনার তালিকা থাকে। কোনো বার্তার বিষয়বস্তু নেই, কোনো API-Key নেই।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رپورٹ میں ڈیوائس ماڈل، iOS ورژن، ایپ ورژن، فراہم کنندہ کا نام اور واقعات کی فہرست شامل ہے۔ کوئی پیغام کا مواد نہیں، کوئی API-Key نہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan berisi model perangkat, versi iOS, versi aplikasi, nama penyedia, dan daftar kejadian. Tidak ada isi pesan, tidak ada API-Key."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapor cihaz modelini, iOS sürümünü, uygulama sürümünü, sağlayıcı adını ve olay listesini içerir. Mesaj içeriği yok, API-Key yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo chứa model thiết bị, phiên bản iOS, phiên bản ứng dụng, tên nhà cung cấp và danh sách sự kiện. Không có nội dung tin nhắn, không có API-Key."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고서에는 기기 모델, iOS 버전, 앱 버전, 제공자 이름, 이벤트 목록이 포함됩니다. 메시지 내용이나 API-Key는 포함되지 않습니다."
          }
        }
      }
    },
    "Der Chat entscheidet selbst, wen er fragt. Ausgeschaltete Agenten werden nie gefragt.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدردشة تقرّر بنفسها من تسأل. الوكلاء المُطفأون لا تُطرح عليهم أسئلة أبدًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chat decides for itself who to ask. Agents that are switched off are never asked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat decide solo a quién pregunta. A los agentes desactivados nunca les pregunta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat décide lui-même qui consulter. Les agents désactivés ne sont jamais consultés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chat decide da sola chi interpellare. Gli agenti disattivati non vengono mai interpellati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰に聞くかはチャットが自分で決めるよ。オフのエージェントには聞かない。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O chat decide sozinho a quem perguntar. Agentes desligados nunca são consultados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат сам решает, кого спросить. Выключенных агентов он не спрашивает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天会自己决定问谁。已关闭的智能体永远不会被问到。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट खुद तय करता है कि किससे पूछना है। बंद किए गए Agents से कभी नहीं पूछा जाता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চ্যাট নিজেই ঠিক করে কাকে জিজ্ঞাসা করবে। বন্ধ থাকা Agent-দের কখনো জিজ্ঞাসা করা হয় না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چیٹ خود فیصلہ کرتی ہے کہ کس سے پوچھنا ہے۔ بند کیے گئے Agents سے کبھی نہیں پوچھا جاتا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat sendiri yang menentukan siapa yang ditanya. Agent yang dinonaktifkan tidak pernah ditanya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet kime soracağına kendi karar verir. Kapatılan Agent'lara asla sorulmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chuyện tự quyết định hỏi ai. Agent bị tắt sẽ không bao giờ được hỏi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅이 누구에게 물어볼지 스스로 결정합니다. 꺼진 Agent에게는 절대 묻지 않습니다."
          }
        }
      }
    },
    "Der Chat-Verlauf konnte weder gelesen noch gesichert werden ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chat history could be neither read nor backed up "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer ni respaldar el historial del chat "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique du chat n'a pu être ni lu ni sauvegardé "
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler nem salvaguardar o histórico da conversa "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere né mettere al sicuro la cronologia chat "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天记录既读不出来，也备份不了 "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット履歴を読み込むことも退避することもできませんでした"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Историю чата не удалось ни прочитать, ни сохранить "
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة سجل المحادثة أو حفظه "
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट हिस्ट्री न तो पढ़ी जा सकी और न सुरक्षित की जा सकी "
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চ্যাট ইতিহাস পড়া বা সংরক্ষণ কোনোটিই করা যায়নি "
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چیٹ کی تاریخ نہ پڑھی جا سکی نہ محفوظ کی جا سکی "
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat chat tidak dapat dibaca maupun disimpan "
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet geçmişi ne okunabildi ne de yedeklenebildi "
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc cũng không thể sao lưu lịch sử trò chuyện "
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 기록을 읽을 수도, 백업할 수도 없었습니다 "
          }
        }
      }
    },
    "Der Claude-Abo-Login funktioniert meist, ist aber für Dritt-Apps nicht offiziell garantiert. Für volle Zuverlässigkeit: ein eigener API-Key (Pay-as-you-go).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول باشتراك Claude يعمل غالباً، لكنه غير مضمون رسمياً للتطبيقات الخارجية. وللثبات الكامل: مفتاح API خاص بك (دفع حسب الاستخدام)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Claude subscription login usually works, but it isn't officially guaranteed for third-party apps. For full reliability, use your own API key (pay-as-you-go)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión con la suscripción de Claude suele funcionar, pero no está garantizado oficialmente para apps de terceros. Para máxima fiabilidad: tu propia clave API (pago por uso)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à l'abonnement Claude marche la plupart du temps, mais elle n'est pas officiellement garantie pour les apps tierces. Pour une fiabilité totale : ta propre clé API (paiement à l'usage)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso con abbonamento Claude di solito funziona, ma non è garantito ufficialmente per le app di terze parti. Per la massima affidabilità: una chiave API tua (pay-as-you-go)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude のサブスクログインはたいてい動きますが、サードパーティアプリでの利用は公式には保証されていません。確実に使うなら自分の API キー（従量課金）を。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão com subscrição Claude costuma funcionar, mas não é oficialmente garantido para apps de terceiros. Para total fiabilidade: uma chave API própria (pay-as-you-go)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход по подписке Claude обычно работает, но официально для сторонних приложений не гарантирован. Для полной надёжности — свой API-ключ (оплата по факту)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 订阅登录大多能用，但官方并不保证第三方应用可以这么用。想要完全可靠：用自己的 API 密钥（按量付费）。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude सब्सक्रिप्शन लॉगिन आमतौर पर काम करता है, लेकिन थर्ड-पार्टी ऐप्स के लिए इसकी आधिकारिक गारंटी नहीं है। पूरी भरोसेमंदी के लिए: अपना API-Key (Pay-as-you-go)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude সাবস্ক্রিপশন লগইন সাধারণত কাজ করে, তবে থার্ড-পার্টি অ্যাপের জন্য অফিসিয়ালি নিশ্চিত নয়। পূর্ণ নির্ভরযোগ্যতার জন্য: নিজস্ব API-Key (Pay-as-you-go)।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude سبسکرپشن لاگ اِن عام طور پر کام کرتا ہے، لیکن تھرڈ پارٹی ایپس کے لیے سرکاری طور پر ضمانت شدہ نہیں۔ مکمل اعتماد کے لیے: اپنی API-Key (Pay-as-you-go)۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Login langganan Claude biasanya berfungsi, tetapi tidak dijamin secara resmi untuk aplikasi pihak ketiga. Untuk keandalan penuh: API-Key sendiri (bayar sesuai pemakaian)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude abonelik girişi genellikle çalışır, ancak üçüncü taraf uygulamalar için resmi olarak garanti edilmez. Tam güvenilirlik için: kendi API-Key'iniz (kullandıkça öde)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập gói đăng ký Claude thường hoạt động, nhưng không được đảm bảo chính thức cho ứng dụng bên thứ ba. Để đáng tin cậy hoàn toàn: dùng API-Key riêng (trả theo mức dùng)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 구독 로그인은 대개 작동하지만 타사 앱에는 공식적으로 보장되지 않습니다. 완전한 안정성을 위해서는: 자체 API-Key(사용량 기반 결제)."
          }
        }
      }
    },
    "Der Datenspeicher lässt sich nicht öffnen — Änderungen dieser Sitzung gehen beim Beenden verloren.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح مخزن البيانات — ستُفقد تغييرات هذه الجلسة عند الإغلاق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data store can't be opened — changes from this session will be lost when you quit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede abrir el almacén de datos: los cambios de esta sesión se perderán al cerrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ouvrir le stockage des données — les modifications de cette session seront perdues à la fermeture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire l'archivio dati — le modifiche di questa sessione andranno perse alla chiusura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データの保存先を開けません — この起動中の変更は終了時に失われます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível abrir o armazenamento de dados — as alterações desta sessão perdem-se ao fechar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище данных не открывается — изменения этого сеанса пропадут при выходе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开数据存储 — 本次会话的改动会在退出时丢失。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा स्टोर खोला नहीं जा सका — इस सत्र में किए गए बदलाव बंद करते ही खो जाएँगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেটা স্টোর খোলা যাচ্ছে না — এই সেশনের পরিবর্তন বন্ধ হলে হারিয়ে যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیٹا اسٹور کھولا نہیں جا سکتا — اس سیشن کی تبدیلیاں بند کرنے پر ضائع ہو جائیں گی۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan data tidak dapat dibuka — perubahan sesi ini akan hilang saat ditutup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veri deposu açılamıyor — bu oturumdaki değişiklikler kapatıldığında kaybolur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho dữ liệu không thể mở — thay đổi trong phiên này sẽ mất khi đóng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 저장소를 열 수 없습니다 — 이 세션의 변경 사항은 종료 시 손실됩니다."
          }
        }
      }
    },
    "Der Prozess endete, ohne dass die App es mitbekommen hat. Die Ursachen unten sind nach Plausibilität geordnet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت العملية دون أن يلاحظ التطبيق ذلك. والأسباب أدناه مرتّبة حسب الاحتمالية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The process ended without the app noticing. The causes below are ordered by how likely they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proceso terminó sin que la app se enterara. Las causas de abajo están ordenadas por plausibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processus s'est terminé sans que l'app s'en aperçoive. Les causes ci-dessous sont classées par plausibilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il processo è terminato senza che l'app se ne accorgesse. Le cause qui sotto sono ordinate per plausibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが気づかないうちにプロセスが終了しました。下の原因は、可能性の高い順に並べています。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O processo terminou sem que a app desse por isso. As causas abaixo estão ordenadas por plausibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процесс завершился, а приложение этого не заметило. Причины ниже отсортированы по правдоподобности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进程被结束时应用完全没有察觉。下面的原因按可能性排序。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोसेस बिना ऐप को पता चले समाप्त हो गया। नीचे दिए कारण संभावना के हिसाब से क्रम में हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রসেস শেষ হয়েছে, অ্যাপ তা জানতে পারেনি। নিচের কারণগুলো সম্ভাব্যতা অনুযায়ী সাজানো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پراسیس ختم ہو گیا، ایپ کو پتہ نہیں چلا۔ نیچے دی گئی وجوہات امکان کے مطابق ترتیب دی گئی ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses berakhir tanpa diketahui aplikasi. Penyebab di bawah diurutkan menurut kemungkinan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süreç, uygulama fark etmeden sona erdi. Aşağıdaki nedenler olasılığa göre sıralanmıştır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiến trình kết thúc mà ứng dụng không nhận biết được. Các nguyên nhân bên dưới được sắp xếp theo mức độ khả thi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 인지하지 못한 채 프로세스가 종료되었습니다. 아래 원인은 가능성 순으로 정렬되어 있습니다."
          }
        }
      }
    },
    "Der Prozess ist beendet worden, ohne dass die App das mitbekommen hat.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The process was killed without the app noticing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proceso se terminó sin que la app se enterara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processus a été arrêté sans que l'app s'en aperçoive."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O processo foi terminado sem que a app se apercebesse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il processo è stato terminato senza che l'app se ne accorgesse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
