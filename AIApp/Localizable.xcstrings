    "Denkt nur mit — nutzt keine Tools und baut nichts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just thinks along — uses no tools, builds nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo piensa contigo — no usa herramientas ni construye nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réfléchit seulement — n'utilise aucun outil et ne construit rien."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só pensa contigo — não usa ferramentas nem constrói nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ragiona e basta — non usa strumenti e non costruisce niente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只负责出主意 — 不用工具，也不动手做。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒に考えるだけ — ツールは使わず、何も作らない。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только размышляет — не пользуется инструментами и ничего не создаёт."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفكّر معك فقط — بلا أدوات ولا يبني شيئًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ साथ सोचता है — कोई टूल इस्तेमाल नहीं करता, कुछ नहीं बनाता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু চিন্তা করে — কোনো টুল ব্যবহার করে না, কিছু তৈরি করে না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف سوچتا ہے — کوئی ٹول استعمال نہیں کرتا، کچھ نہیں بناتا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya berpikir — tidak menggunakan tool dan tidak membangun apa pun."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece düşünür — hiçbir araç kullanmaz ve hiçbir şey oluşturmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ suy nghĩ — không dùng công cụ và không xây dựng gì cả."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생각만 합니다 — 도구를 사용하지 않고 아무것도 만들지 않습니다."
          }
        }
      }
    },
