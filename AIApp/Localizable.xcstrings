    "Noch kein Konto — am besten einen API-Key eintragen (Pay-as-you-go).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account yet — best to add an API key (pay-as-you-go)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay cuenta — lo mejor es añadir una clave de API (pago por uso)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de compte — le plus simple est de saisir une clé API (paiement à l'usage)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem conta — o melhor é introduzir uma chave de API (pay-as-you-go)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun account — meglio inserire una API key (pay-as-you-go)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有账户 — 最好填一个 API Key（按量付费）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントはまだなし — API キーを入力するのがおすすめ（従量課金）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунта пока нет — проще всего добавить API-ключ (оплата по факту)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حساب بعد — الأفضل إضافة مفتاح API (الدفع حسب الاستخدام)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई खाता नहीं — API-Key डालना सबसे अच्छा है (Pay-as-you-go)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো অ্যাকাউন্ট নেই — সবচেয়ে ভালো একটি API-Key দিন (Pay-as-you-go)।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی اکاؤنٹ نہیں — بہتر ہے ایک API-Key درج کریں (Pay-as-you-go)۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada akun — sebaiknya masukkan API-Key (bayar sesuai pemakaian)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz hesap yok — en iyisi bir API-Key girin (kullandıkça öde)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có tài khoản — tốt nhất nên nhập một API-Key (trả theo mức dùng)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 계정 없음 — API-Key(사용량 기반 결제)를 입력하는 것이 가장 좋습니다."
          }
        }
      }
    },
