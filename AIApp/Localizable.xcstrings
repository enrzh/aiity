    "Was dafür/dagegen spricht, steht in den Fakten oben und den Ereignissen unten.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يؤيّد ذلك أو ينفيه تجده في الحقائق أعلاه والأحداث أدناه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What backs each one up or rules it out is in the facts above and the events below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los argumentos a favor y en contra están en los datos de arriba y en los eventos de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui plaide pour ou contre se trouve dans les faits ci-dessus et les événements ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi a favore e contro sono nei dati qui sopra e negli eventi qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判断の材料は、上の事実と下のイベント一覧にあります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os argumentos a favor e contra estão nos dados acima e nos eventos abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргументы за и против — в фактах выше и в событиях ниже."
          }
        },
