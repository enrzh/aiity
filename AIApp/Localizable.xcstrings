    "Kein API-Key / Abo-Login — unter KI-Anbieter ein Konto verbinden.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد مفتاح API أو تسجيل دخول بالاشتراك — اربط حسابًا من قسم المزوّدين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No API key / subscription login — connect an account under AI Providers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin API key ni acceso de suscripción — conecta una cuenta en Proveedores de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé API ni connexion abonnement — connecte un compte dans Fournisseurs IA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna chiave API / login abbonamento — collega un account in Provider IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーもサブスクログインもありません — AI プロバイダでアカウントを接続してね。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem chave API nem sessão de subscrição — liga uma conta em Fornecedores de IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет API-ключа или входа по подписке — подключи аккаунт в разделе «Провайдеры»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 API 密钥 / 订阅登录 — 请在 AI 服务商里连接一个账户。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई API-Key / सब्सक्रिप्शन लॉगिन नहीं — AI प्रोवाइडर में जाकर खाता जोड़ें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো API-Key / সাবস্ক্রিপশন লগইন নেই — AI Provider-এ গিয়ে একটি অ্যাকাউন্ট যুক্ত করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی API-Key / سبسکرپشن لاگ اِن نہیں — AI Provider میں جا کر ایک اکاؤنٹ جوڑیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada API-Key / login langganan — hubungkan akun di AI Provider."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Key / abonelik girişi yok — AI Sağlayıcı'da bir hesap bağlayın."
