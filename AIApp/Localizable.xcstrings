    "Konten gelten für alle Nutzungsarten dieses Anbieters. Das Bild-Modell wird im Abschnitt Bild gewählt.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسري الحسابات على كل استخدامات هذا المزوّد. أما نموذج الصور فيُختار في قسم الصور."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts apply to every use of this provider. The image model is picked in the Image section."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas valen para todos los usos de este proveedor. El modelo de imagen se elige en la sección Imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes valent pour tous les usages de ce fournisseur. Le modèle d'image se choisit dans la section Image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli account valgono per tutti gli usi di questo provider. Il modello per le immagini si sceglie nella sezione Immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントはこのプロバイダのすべての用途に使われます。画像モデルは「画像」セクションで選びます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As contas valem para todas as utilizações deste fornecedor. O modelo de imagem escolhe-se na secção Imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунты действуют для всех задач этого провайдера. Модель изображений выбирается в разделе «Изображения»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户对该服务商的所有用途都生效。图片模型在“图片”一节里选择。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते इस प्रोवाइडर के सभी उपयोगों पर लागू होते हैं। इमेज मॉडल इमेज सेक्शन में चुना जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্টগুলো এই প্রোভাইডারের সব ব্যবহারের ক্ষেত্রে প্রযোজ্য। ইমেজ মডেল ইমেজ সেকশনে বাছা হয়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹس اس فراہم کنندہ کے تمام استعمال پر لاگو ہوتے ہیں۔ امیج ماڈل امیج سیکشن میں منتخب کیا جاتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun berlaku untuk semua jenis penggunaan penyedia ini. Model gambar dipilih di bagian Gambar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplar bu sağlayıcının tüm kullanım türleri için geçerlidir. Görsel modeli, Görsel bölümünde seçilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản áp dụng cho mọi cách sử dụng nhà cung cấp này. Mô hình hình ảnh được chọn trong phần Hình ảnh."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정은 이 제공자의 모든 사용 방식에 적용됩니다. 이미지 모델은 이미지 섹션에서 선택합니다."
          }
        }
      }
    },
