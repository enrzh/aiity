    "Braucht einen eigenen Key bzw. Server. Ohne gültige Angaben fällt die Suche auf DuckDuckGo zurück.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج مفتاحاً أو خادماً خاصاً بك. وبدون بيانات صالحة يعود البحث إلى DuckDuckGo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs your own key or server. Without valid details, search falls back to DuckDuckGo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita una clave o un servidor propios. Sin datos válidos, la búsqueda vuelve a DuckDuckGo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite ta propre clé ou ton propre serveur. Sans informations valides, la recherche bascule sur DuckDuckGo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede una chiave o un server propri. Senza dati validi la ricerca torna a DuckDuckGo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のキーまたはサーバーが必要です。設定が正しくない場合、検索は DuckDuckGo に戻ります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de uma chave ou servidor próprio. Sem dados válidos, a pesquisa recorre ao DuckDuckGo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен свой ключ или сервер. Без корректных данных поиск переключится на DuckDuckGo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你自己的密钥或服务器。信息不完整时，搜索会回退到 DuckDuckGo。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके लिए अपना Key या सर्वर चाहिए। सही जानकारी न होने पर सर्च DuckDuckGo पर वापस चली जाती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিজস্ব Key বা সার্ভার প্রয়োজন। বৈধ তথ্য না থাকলে সার্চ DuckDuckGo-তে ফিরে যায়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی Key یا سرور درکار ہے۔ درست تفصیلات کے بغیر تلاش DuckDuckGo پر واپس چلی جاتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membutuhkan Key atau server sendiri. Tanpa data yang valid, pencarian akan kembali ke DuckDuckGo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi Key'ine ya da sunucusuna ihtiyaç duyar. Geçerli bilgi olmadan arama DuckDuckGo'ya döner."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần Key hoặc server riêng. Không có thông tin hợp lệ, tìm kiếm sẽ quay về DuckDuckGo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 Key 또는 서버가 필요합니다. 유효한 정보가 없으면 검색이 DuckDuckGo로 대체됩니다."
          }
        }
      }
    },
    "Braucht ~%@ — dieses iPhone (%@) gibt einer App ~%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs ~%@ — this iPhone (%@) gives an app ~%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita ~%@ — este iPhone (%@) da a una app ~%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite ~%@ — cet iPhone (%@) ne donne à une app que ~%@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de ~%@ — este iPhone (%@) dá a um app ~%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede ~%@ — questo iPhone (%@) dà a un’app ~%@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Butuh ~%@ — iPhone ini (%@) hanya memberi satu aplikasi ~%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần ~%@ — iPhone này (%@) chỉ cấp cho một ứng dụng ~%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно ~%@ — этот iPhone (%@) даёт приложению ~%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ gerekir — bu iPhone (%@) bir uygulamaya ~%@ verir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約 %@ 必要 — この iPhone（%@）がアプリに渡せるのは約 %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %@ 필요 — 이 iPhone(%@)이 앱에 주는 용량은 약 %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要约 %@ — 这台 iPhone（%@）只能给一个 App 约 %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ चाहिए — यह iPhone (%@) किसी ऐप को ~%@ ही देता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ দরকার — এই iPhone (%@) একটি অ্যাপকে ~%@ দেয়"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج ~%@ — هذا iPhone (%@) يمنح التطبيق ~%@ فقط"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ درکار ہے — یہ iPhone (%@) ایک ایپ کو صرف ~%@ دیتا ہے"
          }
        }
      }
    },
