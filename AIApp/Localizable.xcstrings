            "value": "ایک نجی پتے (%@) پر ری ڈائریکٹ بلاک کر دیا گیا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengalihan ke alamat privat (%@) diblokir."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel bir adrese (%@) yönlendirme engellendi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển hướng đến địa chỉ riêng tư (%@) đã bị chặn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 주소(%@)로의 리디렉션이 차단되었습니다."
          }
        }
      }
    },
    "Werkzeuge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools"
          }
        }
      }
    },
    "Werkzeuge senden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send tools"
          }
        }
      }
    },
    "Werkzeuge sind Websuche, Seiten lesen, Bilder erzeugen und die Geräte-Tools. Kleine Modelle (Ollama, LM Studio, LocalAI, On-Device) erfinden damit oft Funktionsaufrufe statt zu antworten — nur sie bekommen deshalb standardmäßig keine. Gateways und eigene OpenAI-kompatible Server bekommen sie, weil dort meist große Modelle laufen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools means web search, reading pages, generating images and the device tools. Small models (Ollama, LM Studio, LocalAI, on-device) often invent function calls instead of answering — which is why only they get none by default. Gateways and your own OpenAI-compatible servers do get them, because those usually run large models."
          }
        }
      }
    },
    "Werkzeuge sind aktiv — auch bei einem kleinen Modell.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools are on — even for a small model."
          }
        }
      }
    },
    "Werkzeuge sind aus — auch bei einem großen Modell.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools are off — even for a large model."
          }
        }
      }
    },
