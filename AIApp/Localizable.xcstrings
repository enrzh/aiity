          }
        }
      }
    },
    "Übersetzt Texte natürlich statt wörtlich, behält Ton und Fachbegriffe bei und markiert Stellen, die im Original mehrdeutig sind.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يترجم النصوص بأسلوب طبيعي لا حرفي، يحافظ على النبرة والمصطلحات، ويشير إلى المواضع الغامضة في الأصل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translates naturally rather than literally, keeps the tone and the terminology, and flags anything that's ambiguous in the original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce con naturalidad en vez de literalmente, mantiene el tono y los términos técnicos y señala los pasajes ambiguos del original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduit les textes de façon naturelle plutôt que littérale, conserve le ton et les termes techniques et signale les passages ambigus dans l'original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce in modo naturale invece che letterale, mantiene tono e termini tecnici e segnala i punti ambigui nell'originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直訳ではなく自然に訳し、トーンと専門用語を保ちます。原文があいまいな箇所は明示します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduz de forma natural em vez de literal, mantém o tom e os termos técnicos e assinala as passagens ambíguas no original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводит естественно, а не дословно, сохраняет тон и терминологию и отмечает места, двусмысленные в оригинале."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译力求地道而非逐字直译，保留语气和专业术语，并标出原文里含义模糊的地方。"
          }
        }
      }
    },
