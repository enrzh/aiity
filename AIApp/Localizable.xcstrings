    "Vorschau von **%@** %@. Quellcode ist an die KI übergeben — sag, was ich anpassen soll; danach speichern wir die neue Version.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview of **%@** %@. The source code has been handed to the AI — tell me what to adjust; then we'll save the new version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa de **%@** %@. El código fuente está en manos de la IA — dime qué debo ajustar; después guardamos la nueva versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu de **%@** %@. Le code source a été transmis à l'IA — dis-moi ce que je dois ajuster ; ensuite on enregistre la nouvelle version."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualização de **%@** %@. O código-fonte foi entregue à IA — diz o que queres que eu ajuste; depois guardamos a nova versão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima di **%@** %@. Il codice sorgente è stato passato all'IA — dimmi cosa devo modificare; poi salviamo la nuova versione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@** 的预览 %@。源代码已交给 AI — 说说我该调整什么；之后我们保存新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@** のプレビュー %@。ソースコードはAIに渡してあります — どこを調整するか教えてね。そのあと新しいバージョンを保存します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотр **%@** %@. Исходный код передан ИИ — скажи, что подправить; потом сохраним новую версию."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاينة **%@** %@. تم تمرير الشيفرة المصدرية إلى الذكاء الاصطناعي — قل لي ما أُعدّله؛ ثم نحفظ النسخة الجديدة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@** %@ का प्रीव्यू। सोर्स कोड AI को दे दिया गया है — बताएँ मुझे क्या बदलना है; फिर हम नया वर्शन सेव करेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@** %@-এর প্রিভিউ। সোর্স কোড AI-কে দেওয়া হয়েছে — বলুন কী বদলাতে হবে; তারপর আমরা নতুন ভার্সন সেভ করব।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@** %@ کا پیش منظر۔ سورس کوڈ AI کو دیا جا چکا ہے — بتائیں کیا ایڈجسٹ کرنا ہے؛ پھر ہم نیا ورژن محفوظ کریں گے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau **%@** %@. Kode sumber telah diberikan ke AI — katakan apa yang harus disesuaikan; setelah itu kita simpan versi baru."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@** %@'nin önizlemesi. Kaynak kod AI'ya verildi — neyi ayarlamam gerektiğini söyleyin; sonra yeni sürümü kaydedeceğiz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem trước **%@** %@. Mã nguồn đã được chuyển cho AI — hãy nói điều cần điều chỉnh; sau đó chúng ta sẽ lưu phiên bản mới."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@** %@의 미리보기. 소스 코드가 AI에 전달되었습니다 — 무엇을 조정해야 할지 말씀해 주세요; 그 후 새 버전을 저장하겠습니다."
          }
        }
      }
    },
