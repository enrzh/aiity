    "Rate-Limit erreicht — kurz warten und erneut versuchen (ggf. anderes Modell/Konto).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate limit hit — wait a moment and try again (or use another model/account)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de peticiones alcanzado — espera un momento y reinténtalo (o prueba otro modelo/cuenta)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de requêtes atteinte — attends un peu et réessaie (au besoin, autre modèle/compte)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de pedidos atingido — espera um pouco e tenta de novo (ou usa outro modelo/conta)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate limit raggiunto — aspetta un attimo e riprova (eventualmente con un altro modello/account)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到速率限制 — 稍等一下再试（也可以换个模型/账户）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レート制限に達しました — 少し待ってからやり直してください（必要なら別のモデル／アカウントで）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут лимит запросов — подожди немного и повтори (можно сменить модель или аккаунт)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغتَ حدّ المعدّل — انتظر قليلًا ثم أعد المحاولة (أو جرّب نموذجًا/حسابًا آخر)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate-Limit पूरी हो गई — थोड़ा इंतज़ार करके फिर कोशिश करें (चाहें तो दूसरा मॉडल/खाता इस्तेमाल करें)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate-Limit পূর্ণ হয়েছে — একটু অপেক্ষা করে আবার চেষ্টা করুন (প্রয়োজনে অন্য মডেল/অ্যাকাউন্ট)।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate-Limit پوری ہو گئی — تھوڑا انتظار کر کے دوبارہ کوشش کریں (چاہیں تو دوسرا ماڈل/اکاؤنٹ استعمال کریں)۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate-limit tercapai — tunggu sebentar dan coba lagi (jika perlu gunakan model/akun lain)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate-Limit'e ulaşıldı — kısa süre bekleyip tekrar deneyin (gerekirse başka bir model/hesap kullanın)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đạt giới hạn tốc độ — đợi một chút và thử lại (nếu cần dùng mô hình/tài khoản khác)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate-Limit 도달 — 잠시 기다린 후 다시 시도하세요 (필요하면 다른 모델/계정 사용)."
          }
        }
      }
    },
    "Rechenfehler — Division durch null oder Überlauf.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ حسابي — قسمة على صفر أو تجاوز في السعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arithmetic error — division by zero or overflow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de cálculo: división por cero o desbordamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur de calcul — division par zéro ou dépassement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errore di calcolo — divisione per zero o overflow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算エラー — ゼロ除算またはオーバーフローです。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro de cálculo — divisão por zero ou overflow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка вычисления — деление на ноль или переполнение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算错误 — 除以零或溢出。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गणना त्रुटि — शून्य से भाग या ओवरफ़्लो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গণনা ত্রুটি — শূন্য দিয়ে ভাগ বা ওভারফ্লো।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب کی خرابی — صفر سے تقسیم یا اوورفلو۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesalahan perhitungan — pembagian dengan nol atau overflow."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplama hatası — sıfıra bölme veya taşma."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi tính toán — chia cho 0 hoặc tràn số."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산 오류 — 0으로 나누기 또는 오버플로우."
          }
        }
      }
    },
    "Recherchiert Fakten im Web, prüft sie an mehreren Quellen und fasst sie mit Quellenangabe zusammen. Sagt ausdrücklich, wenn etwas unsicher oder widersprüchlich ist.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث عن الحقائق في الويب، ويتحقق منها عبر عدة مصادر ويلخّصها مع ذكر المصدر. ويصرّح بوضوح عندما يكون شيء غير مؤكد أو متناقضاً."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Researches facts on the web, checks them against several sources and sums them up with citations. Says outright when something is uncertain or contradictory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca datos en la web, los contrasta con varias fuentes y los resume citando el origen. Dice claramente cuándo algo es incierto o contradictorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche des faits sur le web, les vérifie auprès de plusieurs sources et les résume en citant ses sources. Dit clairement quand quelque chose est incertain ou contradictoire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca i fatti sul web, li verifica su più fonti e li riassume citando le fonti. Dice esplicitamente quando qualcosa è incerto o contraddittorio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブで事実を調べ、複数の情報源で裏を取り、出典付きでまとめます。不確かな点や矛盾ははっきり伝えます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquisa factos na web, confirma-os em várias fontes e resume-os com indicação da fonte. Diz claramente quando algo é incerto ou contraditório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет факты в интернете, сверяет их по нескольким источникам и излагает со ссылками. Прямо говорит, если что-то неточно или противоречиво."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在网上查证事实，交叉比对多个来源，并附出处做总结。遇到不确定或互相矛盾的信息会明确指出。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वेब पर तथ्य खोजता है, कई स्रोतों से जाँचता है और स्रोत के साथ सारांश देता है। साफ़ बताता है जब कुछ अनिश्चित या विरोधाभासी हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়েবে তথ্য খুঁজে বের করে, একাধিক উৎসে যাচাই করে এবং উৎস উল্লেখ করে সংক্ষিপ্ত করে। কিছু অনিশ্চিত বা বিরোধপূর্ণ হলে স্পষ্টভাবে বলে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ویب پر حقائق تلاش کرتا ہے، متعدد ذرائع سے جانچتا ہے اور حوالے کے ساتھ خلاصہ کرتا ہے۔ واضح طور پر بتاتا ہے جب کچھ غیر یقینی یا متضاد ہو۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meneliti fakta di web, memeriksanya dengan beberapa sumber, dan merangkumnya dengan referensi sumber. Menyatakan dengan jelas jika ada yang tidak pasti atau kontradiktif."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web'de gerçekleri araştırır, birden fazla kaynakla kontrol eder ve kaynak belirterek özetler. Bir şey belirsiz veya çelişkiliyse açıkça belirtir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghiên cứu sự thật trên web, kiểm tra qua nhiều nguồn và tóm tắt kèm trích dẫn nguồn. Nói rõ khi điều gì đó không chắc chắn hoặc mâu thuẫn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹에서 사실을 조사하고, 여러 소스로 확인한 후 출처와 함께 요약합니다. 불확실하거나 모순되는 부분이 있으면 명확히 밝힙니다."
          }
        }
      }
    },
    "Runde gestoppt: dem Gerät ging der Speicher aus. ": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف الجولة: نفدت ذاكرة الجهاز. "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Round stopped: the device ran out of memory. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ronda detenida: el dispositivo se quedó sin memoria. "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tour interrompu : l'appareil a manqué de mémoire. "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Turno interrotto: il dispositivo ha esaurito la memoria. "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末のメモリ不足でラウンドを中止しました。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ronda interrompida: o dispositivo ficou sem memória. "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раунд остановлен: на устройстве закончилась память. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮已停止：设备内存不足。 "
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राउंड रुक गया: डिवाइस की मेमोरी खत्म हो गई। "
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রাউন্ড থেমে গেছে: ডিভাইসের মেমরি শেষ হয়ে গেছে। "
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "راؤنڈ رک گیا: ڈیوائس کی میموری ختم ہو گئی۔ "
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ronde dihentikan: memori perangkat habis. "
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tur durduruldu: cihazın belleği tükendi. "
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vòng đã dừng: thiết bị hết bộ nhớ. "
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라운드 중지됨: 기기 메모리가 부족합니다. "
          }
        }
      }
    },
