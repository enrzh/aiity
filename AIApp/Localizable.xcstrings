            "value": "Yalnızca generate_image için görsel modeli. Sohbet modelinden bağımsız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ mô hình hình ảnh cho generate_image. Độc lập với mô hình trò chuyện."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
