          }
        }
      }
    },
    "Die Adressen sind nicht symbolisiert — ein Signal-Handler darf nichts allozieren. Der Systembericht unten liefert dieselben Frames mit Namen, sobald iOS ihn ausliefert.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناوين غير مُحوَّلة إلى أسماء — معالِج الإشارة لا يجوز له حجز ذاكرة. تقرير النظام بالأسفل يعرض نفس الإطارات بأسمائها بمجرّد أن يوفّره iOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The addresses aren't symbolicated — a signal handler must not allocate. The system report below gives you the same frames with names, as soon as iOS delivers it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones no están simbolizadas — un manejador de señales no puede reservar memoria. El informe del sistema de abajo trae los mismos frames con nombre en cuanto iOS lo entrega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adresses ne sont pas symbolisées — un gestionnaire de signal n'a pas le droit d'allouer. Le rapport système ci-dessous donne les mêmes frames avec les noms, dès qu'iOS le fournit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli indirizzi non sono simbolizzati — un signal handler non può allocare memoria. Il report di sistema qui sotto mostra gli stessi frame con i nomi, appena iOS lo fornisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスはシンボル化されていません — シグナルハンドラの中ではメモリを確保できないため。下のシステムレポートが届けば、同じフレームが名前付きで見られるよ。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os endereços não estão simbolizados — um signal handler não pode alocar memória. O relatório do sistema abaixo traz os mesmos frames com nomes, assim que o iOS o disponibilizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреса не символизированы — обработчик сигнала не может выделять память. Системный отчёт ниже покажет те же фреймы с именами, как только iOS его выдаст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些地址没有符号化 — 信号处理程序里不能分配内存。等 iOS 生成系统报告后，下面会显示同样的调用帧并带上名称。"
          }
        }
      }
    },
    "Die App wurde regulär beendet oder in den Hintergrund geschickt.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُغلق التطبيق بشكل طبيعي أو أُرسل إلى الخلفية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app was closed normally or sent to the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se cerró con normalidad o pasó a segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app a été fermée normalement ou mise en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app è stata chiusa normalmente o mandata in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは正常に終了したか、バックグラウンドに移りました。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A app foi fechada normalmente ou enviada para segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение было закрыто штатно или свёрнуто в фон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用是正常退出，或被切到了后台。"
          }
        }
      }
    },
    "Die App „%@“ möchte %@ (%@). Sie kann dabei auch Daten an fremde Server senden. Nur erlauben, wenn du dieser App vertraust.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app “%@” wants to %@ (%@). It can also send data to third-party servers. Only allow this if you trust this app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app «%@» quiere %@ (%@). También puede enviar datos a servidores ajenos. Permítelo solo si confías en esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app « %@ » veut %@ (%@). Elle peut aussi envoyer des données à des serveurs tiers. N'autorise que si tu fais confiance à cette app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A app «%@» quer %@ (%@). Ao fazê-lo, também pode enviar dados para servidores externos. Só permite se confiares nesta app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app «%@» vuole %@ (%@). Può anche inviare dati a server esterni. Consenti solo se ti fidi di questa app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用「%@」想要 %@（%@）。它也可能因此把数据发送到外部服务器。只有信任这个应用时才允许。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App「%@」が %@（%@）を求めています。その際に外部のサーバーへデータを送信することもあります。このアプリを信頼できる場合のみ許可してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%@» запрашивает %@ (%@). При этом оно может отправлять данные на чужие серверы. Разрешай, только если доверяешь этому приложению."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق «%@» يريد %@ (%@). قد يُرسل بذلك بيانات إلى خوادم خارجية. لا تسمح إلا إذا كنت تثق بهذا التطبيق."
          }
        }
      }
    },
    "Die Liste kommt aus dem Cache; „Aktualisieren“ holt sie live vom Anbieter.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القائمة مأخوذة من الذاكرة المؤقتة؛ «تحديث» يجلبها مباشرة من المزوّد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This list comes from the cache; “Refresh” fetches it live from the provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista viene de la caché; «Actualizar» la trae en directo del proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste vient du cache ; « Actualiser » la récupère en direct chez le fournisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista viene dalla cache; con “Aggiorna” la scarichi dal provider in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧はキャッシュから表示。「更新」でプロバイダから最新を取得。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista vem da cache; «Atualizar» vai buscá-la diretamente ao fornecedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список из кэша; «Обновить» запросит актуальный у провайдера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表来自缓存；点“刷新”会从服务商实时获取。"
          }
        }
      }
    },
