    "Adresse deiner sub2api-Instanz (Host:Port). Das iPhone muss sie erreichen — im WLAN per LAN-IP, sonst über Tailscale/VPN.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان نسخة sub2api لديك (Host:Port). يجب أن يصل إليها iPhone — عبر عنوان الشبكة المحلية في الواي-فاي، أو عبر Tailscale/VPN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address of your sub2api instance (host:port). The iPhone has to reach it — by LAN IP on Wi-Fi, otherwise over Tailscale/VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección de tu instancia de sub2api (host:puerto). El iPhone tiene que poder acceder: por IP local en el wifi, o si no por Tailscale/VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse de ton instance sub2api (hôte:port). L'iPhone doit pouvoir l'atteindre — en Wi-Fi via l'IP locale, sinon par Tailscale/VPN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirizzo della tua istanza sub2api (host:porta). L'iPhone deve poterla raggiungere — in Wi-Fi tramite IP locale, altrimenti via Tailscale/VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sub2api インスタンスのアドレス（ホスト:ポート）。iPhone から到達できる必要があります — 同じ Wi-Fi なら LAN IP、それ以外は Tailscale／VPN 経由で。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Endereço da tua instância sub2api (host:porta). O iPhone tem de a alcançar — no Wi-Fi pelo IP local, caso contrário por Tailscale/VPN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес твоего sub2api (хост:порт). iPhone должен до него достучаться — в Wi-Fi по локальному IP, иначе через Tailscale/VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 sub2api 实例地址（主机:端口）。iPhone 必须能访问它 — 同一 Wi-Fi 下用局域网 IP，否则走 Tailscale/VPN。"
          }
        }
      }
    },
