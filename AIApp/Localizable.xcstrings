    "Enthält keine API-Keys oder Logins — die bleiben im Schlüsselbund des Geräts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contains no API keys or logins — those stay in the device keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No contiene claves de API ni inicios de sesión — eso se queda en el llavero del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne contient aucune clé API ni identifiant — ils restent dans le trousseau de l'appareil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não contém chaves de API nem dados de início de sessão — esses ficam no porta-chaves do dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non contiene API key o login — restano nel portachiavi del dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不包含 API Key 或登录信息 — 它们留在设备的钥匙串里。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーやログイン情報は含まれません — それらは端末のキーチェーンに残ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не содержит API-ключей и логинов — они остаются в связке ключей устройства."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي على مفاتيح API أو بيانات دخول — تبقى في سلسلة مفاتيح الجهاز."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें कोई API-Keys या लॉगिन नहीं होते — वे डिवाइस के Keychain में ही रहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে কোনো API-Key বা লগইন নেই — সেগুলো ডিভাইসের Keychain-এ থাকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس میں کوئی API-Key یا لاگ اِن شامل نہیں — وہ ڈیوائس کے Keychain میں رہتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak berisi API-Key atau login — itu tetap di Keychain perangkat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Key veya giriş bilgisi içermez — bunlar cihazın Anahtarlığında kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không chứa API-Key hay thông tin đăng nhập — chúng nằm trong Keychain của thiết bị."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Key나 로그인 정보는 포함되지 않습니다 — 이는 기기의 Keychain에 남아 있습니다."
          }
        }
      }
    },
