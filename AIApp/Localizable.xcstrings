          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通聊天，也能构建 Mini-Apps。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य चैट, जो Mini-Apps भी बनाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাধারণ চ্যাট, যা Mini-Apps-ও তৈরি করে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عام چیٹ، جو Mini-Apps بھی بناتی ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
