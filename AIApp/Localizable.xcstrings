            "value": "前回の起動はクラッシュで終わりました (%@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошлый запуск завершился сбоем (%@)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التشغيل الأخير انتهى بانهيار (%@)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आखिरी शुरुआत क्रैश के साथ खत्म हुई (%@)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ চালু হওয়া একটি ক্র্যাশে শেষ হয়েছে (%@)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آخری آغاز ایک کریش پر ختم ہوا (%@)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peluncuran terakhir berakhir dengan crash (%@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son başlatma bir çökmeyle sonuçlandı (%@)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần khởi động cuối kết thúc bằng một crash (%@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 시작이 크래시로 끝났습니다 (%@)"
          }
        }
      }
    },
    "Liste erscheint sofort aus Cache; „Aktualisieren“ holt frische Modelle vom Server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list shows instantly from cache; “Refresh” fetches fresh models from the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista aparece al instante desde la caché; «Actualizar» trae modelos nuevos del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste s'affiche aussitôt depuis le cache ; « Actualiser » récupère des modèles à jour depuis le serveur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista aparece logo a partir da cache; «Atualizar» vai buscar modelos novos ao servidor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista compare subito dalla cache; «Aggiorna» scarica i modelli aggiornati dal server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表会立刻从缓存显示；点“刷新”从服务器取最新模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧はキャッシュからすぐ表示されます。「更新」でサーバーから最新のモデルを取得します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список сразу берётся из кэша; «Обновить» загрузит свежие модели с сервера."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر القائمة فورًا من الذاكرة المؤقتة؛ «تحديث» يجلب نماذج جديدة من الخادم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूची तुरंत कैश से दिखती है; “अपडेट करें” सर्वर से नए मॉडल लाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তালিকা ক্যাশ থেকে সাথে সাথে দেখা যায়; “Aktualisieren” সার্ভার থেকে নতুন মডেল আনে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فہرست فوراً کیش سے ظاہر ہوتی ہے؛ “Aktualisieren” سرور سے تازہ ماڈلز لاتا ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar muncul segera dari cache; “Aktualisieren” mengambil model terbaru dari server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste anında önbellekten görünür; “Aktualisieren” sunucudan güncel modelleri getirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách hiện ngay từ bộ nhớ đệm; “Aktualisieren” lấy mô hình mới từ server."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록은 캐시에서 즉시 표시됩니다; “Aktualisieren”은 서버에서 최신 모델을 가져옵니다."
          }
        }
      }
    },
