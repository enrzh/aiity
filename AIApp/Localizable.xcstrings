          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tradutor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводчик"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
