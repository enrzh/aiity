    "Abbruch — meist eine nicht abgefangene Ausnahme oder ein fehlgeschlagenes assert.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Abort — usually an uncaught exception or a failed assert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abort — casi siempre una excepción no capturada o un assert fallido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandon — le plus souvent une exception non interceptée ou un assert qui a échoué."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abort — normalmente uma exceção não capturada ou um assert falhado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abort — di solito un'eccezione non gestita o un assert fallito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中止 — 多半是未捕获的异常或失败的 assert。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "異常終了 (abort) — 多くは未捕捉の例外か assert の失敗です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прерывание (abort) — обычно необработанное исключение или проваленный assert."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنهاء قسري (abort) — غالبًا استثناء غير مُلتقَط أو assert فاشل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एबॉर्ट — आमतौर पर बिना संभाला गया अपवाद या असफल assert।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ হয়ে গেছে — সাধারণত একটি অধরা exception বা ব্যর্থ assert।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بند ہو گیا — عام طور پر ایک ان کاٹی گئی exception یا ناکام assert۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhenti — biasanya exception yang tidak tertangani atau assert yang gagal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durduruldu — genellikle yakalanmamış bir istisna veya başarısız bir assert."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng lại — thường do một ngoại lệ không được bắt hoặc một assert thất bại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단 — 대개 처리되지 않은 예외 또는 실패한 assert."
          }
        }
      }
    },
    "Abbruchgrund — genauer als alles, was die App selbst mitschreiben kann.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "termination reason — more precise than anything the app can log itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Motivo de la terminación — más preciso que todo lo que la app pueda registrar por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "motif d'arrêt — plus précis que tout ce que l'app peut consigner elle-même."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "motivo do encerramento — mais preciso do que tudo o que a própria app consegue registar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Motivo della terminazione — più preciso di qualsiasi cosa l'app possa registrare da sé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终止原因 — 比 App 自己能记下的任何信息都准确。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了理由 — アプリ自身が記録できるどの情報よりも正確です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "причину завершения — точнее, чем всё, что приложение способно записать само."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سبب الإنهاء — أدقّ من أي شيء يستطيع التطبيق نفسه تسجيله."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समाप्ति का कारण — जो भी ऐप खुद दर्ज कर सकता है उससे कहीं ज़्यादा सटीक।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ হওয়ার কারণ — অ্যাপ নিজে যা রেকর্ড করতে পারে তার চেয়ে নির্ভুল।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بند ہونے کی وجہ — ایپ خود جو ریکارڈ کر سکتی ہے اس سے زیادہ درست۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alasan penghentian — lebih akurat dari apa pun yang bisa dicatat aplikasi sendiri."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdurma nedeni — uygulamanın kendisinin kaydedebileceğinden daha kesin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lý do dừng — chính xác hơn bất cứ điều gì bản thân ứng dụng có thể ghi lại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단 이유 — 앱 자체가 기록할 수 있는 것보다 더 정확합니다."
          }
        }
      }
    },
