    "Die Adressen sind nicht symbolisiert — ein Signal-Handler darf nichts allozieren. Der Systembericht unten liefert dieselben Frames mit Namen, sobald iOS ihn ausliefert.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناوين غير مُحوَّلة إلى أسماء — معالِج الإشارة لا يجوز له حجز ذاكرة. تقرير النظام بالأسفل يعرض نفس الإطارات بأسمائها بمجرّد أن يوفّره iOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The addresses aren't symbolicated — a signal handler must not allocate. The system report below gives you the same frames with names, as soon as iOS delivers it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones no están simbolizadas — un manejador de señales no puede reservar memoria. El informe del sistema de abajo trae los mismos frames con nombre en cuanto iOS lo entrega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adresses ne sont pas symbolisées — un gestionnaire de signal n'a pas le droit d'allouer. Le rapport système ci-dessous donne les mêmes frames avec les noms, dès qu'iOS le fournit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli indirizzi non sono simbolizzati — un signal handler non può allocare memoria. Il report di sistema qui sotto mostra gli stessi frame con i nomi, appena iOS lo fornisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスはシンボル化されていません — シグナルハンドラの中ではメモリを確保できないため。下のシステムレポートが届けば、同じフレームが名前付きで見られるよ。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os endereços não estão simbolizados — um signal handler não pode alocar memória. O relatório do sistema abaixo traz os mesmos frames com nomes, assim que o iOS o disponibilizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреса не символизированы — обработчик сигнала не может выделять память. Системный отчёт ниже покажет те же фреймы с именами, как только iOS его выдаст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些地址没有符号化 — 信号处理程序里不能分配内存。等 iOS 生成系统报告后，下面会显示同样的调用帧并带上名称。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पते सिंबलीकृत नहीं हैं — सिग्नल हैंडलर कुछ भी आबंटित नहीं कर सकता। नीचे की सिस्टम रिपोर्ट, iOS द्वारा देने पर वही फ़्रेम नामों के साथ देती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঠিকানাগুলো সিম্বলাইজ করা হয়নি — সিগন্যাল-হ্যান্ডলার কিছু বরাদ্দ করতে পারে না। নিচের সিস্টেম রিপোর্টে iOS দেওয়ার সাথে সাথে একই ফ্রেম নাম সহ পাওয়া যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پتے سمبلائزڈ نہیں ہیں — سگنل ہینڈلر کچھ allocate نہیں کر سکتا۔ نیچے دی گئی سسٹم رپورٹ iOS کے فراہم کرتے ہی وہی فریمز نام کے ساتھ دے گی۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat belum disimbolkan — signal handler tidak boleh mengalokasikan apa pun. Laporan sistem di bawah akan memberikan frame yang sama dengan nama begitu iOS menyediakannya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresler sembolleştirilmemiş — sinyal işleyicisi hiçbir şey ayıramaz. Aşağıdaki sistem raporu, iOS onu sağlar sağlamaz aynı çerçeveleri isimlerle verecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các địa chỉ chưa được ký hiệu hóa — signal handler không được cấp phát bất cứ thứ gì. Báo cáo hệ thống bên dưới sẽ cung cấp cùng các khung với tên ngay khi iOS gửi nó."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소가 심볼화되지 않았습니다 — 시그널 핸들러는 어떤 것도 할당할 수 없습니다. 아래 시스템 보고서는 iOS가 제공하는 즉시 동일한 프레임을 이름과 함께 제공합니다."
          }
        }
      }
    },
    "Die App wurde regulär beendet oder in den Hintergrund geschickt.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُغلق التطبيق بشكل طبيعي أو أُرسل إلى الخلفية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app was closed normally or sent to the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se cerró con normalidad o pasó a segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app a été fermée normalement ou mise en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app è stata chiusa normalmente o mandata in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは正常に終了したか、バックグラウンドに移りました。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A app foi fechada normalmente ou enviada para segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение было закрыто штатно или свёрнуто в фон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用是正常退出，或被切到了后台。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप सामान्य रूप से बंद हुआ या बैकग्राउंड में भेजा गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটি স্বাভাবিকভাবে বন্ধ হয়েছে বা ব্যাকগ্রাউন্ডে পাঠানো হয়েছে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ معمول کے مطابق بند ہوئی یا بیک گراؤنڈ میں بھیجی گئی۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ditutup secara normal atau dikirim ke latar belakang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama normal şekilde kapatıldı veya arka plana gönderildi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng đã kết thúc bình thường hoặc được đưa vào nền."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 정상적으로 종료되었거나 백그라운드로 전환되었습니다."
          }
        }
      }
    },
    "Die App „%@“ möchte %@ (%@). Sie kann dabei auch Daten an fremde Server senden. Nur erlauben, wenn du dieser App vertraust.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app “%@” wants to %@ (%@). It can also send data to third-party servers. Only allow this if you trust this app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app «%@» quiere %@ (%@). También puede enviar datos a servidores ajenos. Permítelo solo si confías en esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app « %@ » veut %@ (%@). Elle peut aussi envoyer des données à des serveurs tiers. N'autorise que si tu fais confiance à cette app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A app «%@» quer %@ (%@). Ao fazê-lo, também pode enviar dados para servidores externos. Só permite se confiares nesta app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app «%@» vuole %@ (%@). Può anche inviare dati a server esterni. Consenti solo se ti fidi di questa app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用「%@」想要 %@（%@）。它也可能因此把数据发送到外部服务器。只有信任这个应用时才允许。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App「%@」が %@（%@）を求めています。その際に外部のサーバーへデータを送信することもあります。このアプリを信頼できる場合のみ許可してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение «%@» запрашивает %@ (%@). При этом оно может отправлять данные на чужие серверы. Разрешай, только если доверяешь этому приложению."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق «%@» يريد %@ (%@). قد يُرسل بذلك بيانات إلى خوادم خارجية. لا تسمح إلا إذا كنت تثق بهذا التطبيق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ऐप %@ (%@) करना चाहता है। इसमें यह डेटा किसी बाहरी सर्वर को भी भेज सकता है। सिर्फ़ तभी अनुमति दें जब आपको इस ऐप पर भरोसा हो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” অ্যাপটি %@ (%@) করতে চায়। এটি বাইরের সার্ভারেও ডেটা পাঠাতে পারে। শুধুমাত্র এই অ্যাপে বিশ্বাস থাকলে অনুমতি দিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ “%@” %@ (%@) کرنا چاہتی ہے۔ یہ اجنبی سرورز کو بھی ڈیٹا بھیج سکتی ہے۔ صرف اسی صورت اجازت دیں اگر آپ اس ایپ پر اعتماد کرتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi “%@” ingin %@ (%@). Ini juga dapat mengirim data ke server pihak ketiga. Izinkan hanya jika Anda percaya pada aplikasi ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” uygulaması %@ (%@) yapmak istiyor. Bu sırada yabancı sunuculara veri de gönderebilir. Yalnızca bu uygulamaya güveniyorsanız izin verin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng “%@” muốn %@ (%@). Điều này cũng có thể gửi dữ liệu đến server bên ngoài. Chỉ cho phép nếu bạn tin tưởng ứng dụng này."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 앱이 %@ (%@)을(를) 하려고 합니다. 이 과정에서 외부 서버로 데이터를 전송할 수도 있습니다. 이 앱을 신뢰할 때만 허용하세요."
          }
        }
      }
    },
    "Die Datei konnte nicht gelesen werden.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file couldn't be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'a pas pu être lu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o ficheiro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取该文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込めませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не удалось прочитать."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة الملف."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल पढ़ी नहीं जा सकी।"
          }
        },
        "bn": {
