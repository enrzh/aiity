    "Vorschau von **%@** %@. Quellcode ist an die KI übergeben — sag, was ich anpassen soll; danach speichern wir die neue Version.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview of **%@** %@. The source code has been handed to the AI — tell me what to adjust; then we'll save the new version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa de **%@** %@. El código fuente está en manos de la IA — dime qué debo ajustar; después guardamos la nueva versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu de **%@** %@. Le code source a été transmis à l'IA — dis-moi ce que je dois ajuster ; ensuite on enregistre la nouvelle version."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualização de **%@** %@. O código-fonte foi entregue à IA — diz o que queres que eu ajuste; depois guardamos a nova versão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima di **%@** %@. Il codice sorgente è stato passato all'IA — dimmi cosa devo modificare; poi salviamo la nuova versione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@** 的预览 %@。源代码已交给 AI — 说说我该调整什么；之后我们保存新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@** のプレビュー %@。ソースコードはAIに渡してあります — どこを調整するか教えてね。そのあと新しいバージョンを保存します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотр **%@** %@. Исходный код передан ИИ — скажи, что подправить; потом сохраним новую версию."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاينة **%@** %@. تم تمرير الشيفرة المصدرية إلى الذكاء الاصطناعي — قل لي ما أُعدّله؛ ثم نحفظ النسخة الجديدة."
          }
        }
      }
    },
    "Vorschläge": {
