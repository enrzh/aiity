    "Was dafür/dagegen spricht, steht in den Fakten oben und den Ereignissen unten.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يؤيّد ذلك أو ينفيه تجده في الحقائق أعلاه والأحداث أدناه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What backs each one up or rules it out is in the facts above and the events below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los argumentos a favor y en contra están en los datos de arriba y en los eventos de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui plaide pour ou contre se trouve dans les faits ci-dessus et les événements ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi a favore e contro sono nei dati qui sopra e negli eventi qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判断の材料は、上の事実と下のイベント一覧にあります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os argumentos a favor e contra estão nos dados acima e nos eventos abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аргументы за и против — в фактах выше и в событиях ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持或反对的依据，见上方的事实和下方的事件。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके पक्ष/विपक्ष में क्या है, यह ऊपर के विवरण और नीचे की घटनाओं में है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পক্ষে/বিপক্ষে যা আছে তা উপরের তথ্য ও নিচের ঘটনায় আছে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حق میں/خلاف جو کچھ ہے وہ اوپر کے حقائق اور نیچے کے واقعات میں ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang mendukung/menentang ada dalam fakta di atas dan kejadian di bawah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehinde/aleyhinde olanlar yukarıdaki gerçeklerde ve aşağıdaki olaylarda yer alıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì ủng hộ/phản đối nằm trong các sự thật ở trên và sự kiện bên dưới."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찬성/반대 근거는 위의 사실과 아래의 이벤트에 있습니다."
          }
        }
      }
    },
