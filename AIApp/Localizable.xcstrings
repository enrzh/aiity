    "On-Device MLX unterstützt nur Chat, keine Bildgenerierung.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "MLX على الجهاز يدعم الدردشة فقط، بلا توليد صور."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device MLX supports chat only, no image generation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MLX en el dispositivo solo admite chat, no generación de imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MLX sur l'appareil ne gère que le chat, pas la génération d'images."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MLX sul dispositivo supporta solo la chat, non la generazione di immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内の MLX はチャットのみ対応で、画像生成はできません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O MLX no dispositivo só suporta chat, não gera imagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MLX на устройстве поддерживает только чат, без генерации изображений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端 MLX 只支持聊天，不支持生成图片。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पर MLX सिर्फ़ चैट सपोर्ट करता है, इमेज जनरेशन नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন-ডিভাইস MLX শুধু চ্যাট সাপোর্ট করে, ইমেজ জেনারেশন নয়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آن ڈیوائس MLX صرف چیٹ سپورٹ کرتا ہے، امیج جنریشن نہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "MLX on-device hanya mendukung chat, bukan pembuatan gambar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz üzerinde MLX yalnızca sohbeti destekler, görsel oluşturmayı değil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "MLX trên thiết bị chỉ hỗ trợ trò chuyện, không tạo hình ảnh."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 MLX는 채팅만 지원하며 이미지 생성은 지원하지 않습니다."
          }
        }
      }
    },
