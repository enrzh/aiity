        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 선택한 이모지"
          }
        }
      }
    },
    "Ein Agent darf ein ganz anderes Modell nutzen als der Chat — z. B. ein günstiges für Fleißarbeit und ein starkes fürs Gegenlesen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للوكيل أن يستخدم نموذجاً مختلفاً تماماً عن الدردشة — مثلاً نموذج رخيص للأعمال الروتينية وآخر قوي للمراجعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent can use a completely different model than the chat — say a cheap one for grunt work and a strong one for proofreading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente puede usar un modelo muy distinto al del chat: por ejemplo, uno barato para el trabajo rutinario y uno potente para revisar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent peut utiliser un tout autre modèle que le chat — p. ex. un modèle bon marché pour les tâches répétitives et un modèle puissant pour la relecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente può usare un modello completamente diverso da quello della chat — es. uno economico per il lavoro di routine e uno potente per la rilettura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントにはチャットとまったく別のモデルを使えます — 単純作業は安いモデル、チェックは強力なモデル、といった具合に。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um agente pode usar um modelo completamente diferente do chat — por exemplo, um barato para o trabalho repetitivo e um forte para rever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У агента может быть совсем другая модель, чем у чата — например дешёвая для рутины и сильная для вычитки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体可以用和聊天完全不同的模型 — 比如用便宜的干体力活，用强的做复核。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent चैट से बिलकुल अलग मॉडल इस्तेमाल कर सकता है — जैसे मेहनत वाले काम के लिए सस्ता और जाँचने के लिए मज़बूत मॉडल।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একজন Agent চ্যাটের চেয়ে সম্পূর্ণ ভিন্ন মডেল ব্যবহার করতে পারে — যেমন সাধারণ কাজের জন্য সস্তা, প্রুফরিডিংয়ের জন্য শক্তিশালী।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک Agent چیٹ سے بالکل مختلف ماڈل استعمال کر سکتا ہے — مثلاً عام کام کے لیے سستا اور نظرثانی کے لیے مضبوط۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent boleh menggunakan model yang sama sekali berbeda dari chat — mis. yang murah untuk kerja rutin dan yang kuat untuk proofreading."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Agent, sohbetten tamamen farklı bir model kullanabilir — örn. rutin işler için ucuz bir model ve gözden geçirme için güçlü bir model."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một Agent có thể dùng mô hình hoàn toàn khác với trò chuyện — vd. một mô hình rẻ cho việc thường xuyên và một mô hình mạnh để kiểm tra lại."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent는 채팅과 완전히 다른 모델을 사용할 수 있습니다 — 예를 들어 반복 작업에는 저렴한 모델을, 검토에는 강력한 모델을."
          }
        }
      }
    },
