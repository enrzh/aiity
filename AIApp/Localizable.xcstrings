          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "precondition 失败，或算术溢出。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असफल precondition, या अंकगणितीय ओवरफ़्लो।"
