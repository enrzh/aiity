          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create specialists — the chat asks them on its own when a task fits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea especialistas — el chat les pregunta por su cuenta cuando encajan con la tarea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée des spécialistes — le chat les consulte de lui-même quand une tâche s'y prête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea degli specialisti — la chat li interpella da sola quando un compito fa al caso loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "専門のエージェントを作っておくと、合う仕事のときチャットが自分から相談するよ。"
