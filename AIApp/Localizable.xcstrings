    "Lokale Modelle brauchen ein echtes Gerät (MLX läuft nicht im Simulator).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النماذج المحلية تحتاج جهازاً حقيقياً (MLX لا يعمل في المحاكي)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local models need a real device (MLX doesn't run in the Simulator)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos locales necesitan un dispositivo real (MLX no funciona en el simulador)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles locaux nécessitent un appareil réel (MLX ne tourne pas dans le simulateur)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli locali richiedono un dispositivo reale (MLX non funziona nel simulatore)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルモデルには実機が必要です（MLX はシミュレータでは動きません）。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos locais precisam de um dispositivo real (o MLX não funciona no simulador)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальным моделям нужно реальное устройство (MLX не работает в симуляторе)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型需要真机（MLX 无法在模拟器里运行）。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकल मॉडलों के लिए असली डिवाइस चाहिए (MLX Simulator में नहीं चलता)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লোকাল মডেলের জন্য প্রকৃত ডিভাইস দরকার (MLX সিমুলেটরে চলে না)।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لوکل ماڈلز کو اصل ڈیوائس درکار ہے (MLX سمولیٹر میں نہیں چلتا)۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model lokal membutuhkan perangkat asli (MLX tidak berjalan di simulator)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel modeller gerçek bir cihaz gerektirir (MLX simülatörde çalışmaz)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình cục bộ cần thiết bị thật (MLX không chạy trong Simulator)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 모델에는 실제 기기가 필요합니다 (MLX는 시뮬레이터에서 실행되지 않습니다)."
          }
        }
      }
    },
