    },
    "Ein kleineres lokales Modell wählen, oder für Gruppen einen Cloud-Anbieter.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نموذجاً محلياً أصغر، أو مزوّداً سحابياً للمجموعات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a smaller local model, or a cloud provider for groups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un modelo local más pequeño o, para grupos, un proveedor en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un modèle local plus petit, ou un fournisseur cloud pour les groupes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un modello locale più piccolo, oppure un provider cloud per i gruppi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もっと小さいローカルモデルを選ぶか、グループではクラウドのプロバイダを使ってください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um modelo local mais pequeno ou, para grupos, um fornecedor na nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери локальную модель поменьше или облачного провайдера для групп."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换一个更小的本地模型，或者群聊改用云端服务商。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटा लोकल मॉडल चुनें, या ग्रुप्स के लिए Cloud प्रोवाइडर।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ছোট লোকাল মডেল বাছুন, অথবা গ্রুপের জন্য একটি ক্লাউড প্রোভাইডার।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک چھوٹا لوکل ماڈل منتخب کریں، یا گروپس کے لیے ایک کلاؤڈ فراہم کنندہ۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih model lokal yang lebih kecil, atau untuk grup gunakan penyedia cloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha küçük bir yerel model seçin, ya da gruplar için bir Cloud sağlayıcısı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một mô hình cục bộ nhỏ hơn, hoặc dùng nhà cung cấp cloud cho nhóm."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 작은 로컬 모델을 선택하거나, 그룹에는 클라우드 제공자를 선택하세요."
          }
        }
      }
    },
    "Ein starkes Cloud-Modell — Recherche lebt von Sorgfalt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A strong cloud model — research lives on care."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modelo potente en la nube — investigar bien exige cuidado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle cloud puissant — la recherche vit de rigueur."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um modelo forte na nuvem — pesquisar exige rigor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modello cloud potente — la ricerca vive di accuratezza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强大的云端模型 — 做调研就靠细致。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強力なクラウドモデル — 調査は丁寧さが命。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мощная облачная модель — для поиска нужна тщательность."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نموذج سحابي قوي — البحث الجيّد يحتاج دقّة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक मज़बूत Cloud मॉडल — रिसर्च सावधानी से चलती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি শক্তিশালী ক্লাউড মডেল — গবেষণা সতর্কতার উপর নির্ভর করে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک مضبوط کلاؤڈ ماڈل — ریسرچ احتیاط پر منحصر ہے۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
