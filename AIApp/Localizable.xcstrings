    "der Installation, oder die Diagnose wurde geleert.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "installation, or the diagnostics were cleared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "de la instalación, o se vació el diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "l'installation, ou bien le diagnostic a été vidé."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "da instalação, ou o diagnóstico foi limpo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "dall'installazione, oppure la diagnostica è stata svuotata."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装以来，或者诊断记录被清空过。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール後はじめての起動か、診断が消去されたためです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "с момента установки, либо диагностика была очищена."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التثبيت، أو أن سجل التشخيص قد أُفرغ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉलेशन के बाद पहली बार, या डायग्नोसिस मिटा दी गई थी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনস্টলেশনের পর প্রথমবার, বা ডায়াগনস্টিক পরিষ্কার করা হয়েছিল।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انسٹالیشن کے بعد پہلی بار، یا تشخیص صاف کر دی گئی تھی۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "setelah instalasi, atau diagnosis telah dikosongkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "kurulumdan sonraki ilk sefer, ya da tanı temizlenmişti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "sau khi cài đặt, hoặc chẩn đoán đã bị xóa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 후 첫 실행이거나, 진단 기록이 삭제되었습니다."
          }
        }
      }
    },
    "erhalten bleibt — bitte Speicher freigeben und die App neu starten.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "stays intact — free up storage and restart the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "se conserve — libera espacio y reinicia la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "reste intact — libère de l'espace et redémarre l'app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "se mantenha intacto — liberta espaço e reinicia a app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "resta intatto — libera spazio e riavvia l'app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持完整 — 请释放存储空间，然后重启 App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壊さないよう、書き込みは行いません — 空き容量を確保してアプリを再起動してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "остался цел — освободи место и перезапусти приложение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سليمًا — حرّر بعض المساحة وأعد تشغيل التطبيق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित रहती है — कृपया जगह खाली करें और ऐप को फिर से शुरू करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুরক্ষিত থাকে — অনুগ্রহ করে জায়গা খালি করে অ্যাপ পুনরায় চালু করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ رہے — براہ کرم جگہ خالی کر کے ایپ دوبارہ شروع کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tetap terjaga — silakan bebaskan ruang penyimpanan dan mulai ulang aplikasi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "korunur — lütfen depolama alanı boşaltın ve uygulamayı yeniden başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "được giữ nguyên — vui lòng giải phóng bộ nhớ và khởi động lại ứng dụng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지됩니다 — 저장 공간을 확보하고 앱을 다시 시작하세요."
          }
        }
      }
    },
    "fehlgeschlagene precondition, oder arithmetischer Überlauf.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل precondition، أو تجاوز حسابي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a failed precondition, or arithmetic overflow."
          }
        },
        "es": {
          "stringUnit": {
