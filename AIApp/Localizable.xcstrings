          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-App'ler de oluşturan normal sohbet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chuyện thông thường cũng xây dựng Mini-App."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mini-App도 만드는 일반 채팅."
          }
        }
      }
    },
    "Diagnose": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
