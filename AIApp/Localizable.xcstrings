            "value": "Guided setup for Ollama, LM Studio, LocalAI and OpenAI-compatible servers. Then tap “Test connection”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración guiada para Ollama, LM Studio, LocalAI y servidores compatibles con OpenAI. Después, “Probar conexión”."
