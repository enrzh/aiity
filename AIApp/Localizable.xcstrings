    "(kein Modell gewählt)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "(لم يُحدَّد نموذج)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(no model selected)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(sin modelo seleccionado)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "(aucun modèle choisi)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "(nessun modello scelto)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（モデル未選択）"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "(nenhum modelo escolhido)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "(модель не выбрана)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（未选择模型）"
          }
        }
      }
    },
    "(kein lokales Modell gewählt — unter Anbieter eins laden und auswählen)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "(لم يُحدَّد نموذج محلي — حمّل واحداً من المزوّد ثم اختره)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(no local model selected — load one under Providers and pick it)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "(ningún modelo local seleccionado: carga uno en Proveedores y elígelo)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "(aucun modèle local choisi — charges-en un sous Fournisseurs et sélectionne-le)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "(nessun modello locale scelto — caricane uno in Provider e selezionalo)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（ローカルモデルが未選択です — プロバイダで読み込んで選んでください）"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "(nenhum modelo local escolhido — carrega e seleciona um em Fornecedores)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "(локальная модель не выбрана — загрузи и выбери её в разделе «Провайдеры»)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（未选择本地模型 — 请在“服务商”里加载并选择一个）"
          }
        }
      }
    },
