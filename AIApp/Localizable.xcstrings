    "Aus heißt: alles bleibt nur auf diesem Gerät. Es wird nichts gelöscht.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقافه يعني: يبقى كل شيء على هذا الجهاز فقط. ولن يُحذف شيء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off means everything stays on this device only. Nothing gets deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado significa que todo se queda solo en este dispositivo. No se borra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé veut dire : tout reste uniquement sur cet appareil. Rien n'est supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato significa: tutto resta solo su questo dispositivo. Non viene eliminato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、すべてこの端末内だけに残ります。何も削除されません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado significa: fica tudo só neste dispositivo. Não se apaga nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено — значит всё остаётся только на этом устройстве. Ничего не удаляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭表示：所有内容只留在本机。不会删除任何东西。"
          }
        }
      }
    },
    "Ausgewählte Agenten antworten in dieser Unterhaltung mit — jeder mit seinem eigenen Modell.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوكلاء المحددون يشاركون بالرد في هذه المحادثة — كلٌّ بنموذجه الخاص."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected agents chime in on this conversation — each with its own model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes seleccionados participan en esta conversación, cada uno con su propio modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents sélectionnés répondent aussi dans cette conversation — chacun avec son propre modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti selezionati rispondono in questa conversazione — ognuno con il proprio modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだエージェントがこの会話に一緒に応答します — それぞれ自分のモデルで。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os agentes selecionados participam nesta conversa — cada um com o seu modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные агенты тоже отвечают в этом чате — каждый на своей модели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被选中的智能体会一起参与这场对话 — 各自使用自己的模型。"
          }
        }
      }
    },
    "Auth-Fehler %lld: %@ — API-Key prüfen/erneuern. Bei eigenem Gateway (sub2api): stimmt der sk-…-Key mit dem Server überein?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auth error %lld: %@ — check/renew the API key. With your own gateway (sub2api): does the sk-… key match the server?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de autenticación %lld: %@ — comprueba/renueva la clave API. Con gateway propio (sub2api): ¿coincide la clave sk-… con la del servidor?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur d'authentification %lld : %@ — vérifie ou renouvelle la clé API. Avec ta propre passerelle (sub2api) : la clé sk-… correspond-elle au serveur ?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro de autenticação %lld: %@ — verifica/renova a chave de API. Com gateway próprio (sub2api): a chave sk-… corresponde à do servidor?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errore di autenticazione %lld: %@ — controlla/rinnova la chiave API. Con un gateway tuo (sub2api): la chiave sk-… corrisponde a quella del server?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证错误 %lld：%@ — 请检查或更新 API 密钥。使用自建网关（sub2api）时：sk-… 密钥和服务器上的一致吗？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証エラー %lld: %@ — APIキーを確認・再発行してください。自前のゲートウェイ (sub2api) の場合、sk-… キーはサーバーと一致していますか？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка аутентификации %lld: %@ — проверь или обнови API-ключ. Если у тебя свой шлюз (sub2api): совпадает ли ключ sk-… с сервером?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ مصادقة %lld: %@ — تحقّق من مفتاح API أو جدّده. إذا كنت تستخدم بوابة خاصة بك (sub2api): هل يطابق مفتاح sk-… ما على الخادم؟"
          }
        }
      }
    },
