    "Aus heißt: alles bleibt nur auf diesem Gerät. Es wird nichts gelöscht.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقافه يعني: يبقى كل شيء على هذا الجهاز فقط. ولن يُحذف شيء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off means everything stays on this device only. Nothing gets deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado significa que todo se queda solo en este dispositivo. No se borra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé veut dire : tout reste uniquement sur cet appareil. Rien n'est supprimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato significa: tutto resta solo su questo dispositivo. Non viene eliminato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、すべてこの端末内だけに残ります。何も削除されません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado significa: fica tudo só neste dispositivo. Não se apaga nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено — значит всё остаётся только на этом устройстве. Ничего не удаляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭表示：所有内容只留在本机。不会删除任何东西。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद का मतलब है: सब कुछ सिर्फ़ इसी डिवाइस पर रहता है। कुछ भी डिलीट नहीं होता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ মানে: সবকিছু শুধু এই ডিভাইসেই থাকে। কিছুই মুছে যায় না।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بند کا مطلب ہے: سب کچھ صرف اسی ڈیوائس پر رہتا ہے۔ کچھ بھی حذف نہیں ہوتا۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonaktif berarti: semuanya tetap hanya di perangkat ini. Tidak ada yang dihapus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı demek: her şey yalnızca bu cihazda kalır. Hiçbir şey silinmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt nghĩa là: mọi thứ chỉ ở lại trên thiết bị này. Không có gì bị xóa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼짐은 모든 것이 이 기기에만 남는다는 뜻입니다. 아무것도 삭제되지 않습니다."
          }
        }
      }
    },
    "Ausgewählte Agenten antworten in dieser Unterhaltung mit — jeder mit seinem eigenen Modell.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوكلاء المحددون يشاركون بالرد في هذه المحادثة — كلٌّ بنموذجه الخاص."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected agents chime in on this conversation — each with its own model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes seleccionados participan en esta conversación, cada uno con su propio modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents sélectionnés répondent aussi dans cette conversation — chacun avec son propre modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti selezionati rispondono in questa conversazione — ognuno con il proprio modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだエージェントがこの会話に一緒に応答します — それぞれ自分のモデルで。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os agentes selecionados participam nesta conversa — cada um com o seu modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные агенты тоже отвечают в этом чате — каждый на своей модели."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被选中的智能体会一起参与这场对话 — 各自使用自己的模型。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए Agents इस बातचीत में जवाब देते हैं — हर एक अपने मॉडल के साथ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত Agents এই কথোপকথনে উত্তর দেবে — প্রত্যেকে নিজস্ব মডেল দিয়ে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کردہ Agents اس گفتگو میں جواب دیں گے — ہر ایک اپنے ماڈل کے ساتھ۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent yang dipilih akan ikut menjawab dalam percakapan ini — masing-masing dengan modelnya sendiri."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen Agent'lar bu sohbette yanıt verir — her biri kendi modeliyle."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các Agent đã chọn sẽ tham gia trả lời trong cuộc trò chuyện này — mỗi Agent với mô hình riêng."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 Agent들이 이 대화에 함께 응답합니다 — 각자 자신의 모델로."
          }
        }
      }
    },
    "Auth-Fehler %lld: %@ — API-Key prüfen/erneuern. Bei eigenem Gateway (sub2api): stimmt der sk-…-Key mit dem Server überein?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auth error %lld: %@ — check/renew the API key. With your own gateway (sub2api): does the sk-… key match the server?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de autenticación %lld: %@ — comprueba/renueva la clave API. Con gateway propio (sub2api): ¿coincide la clave sk-… con la del servidor?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur d'authentification %lld : %@ — vérifie ou renouvelle la clé API. Avec ta propre passerelle (sub2api) : la clé sk-… correspond-elle au serveur ?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Erro de autenticação %lld: %@ — verifica/renova a chave de API. Com gateway próprio (sub2api): a chave sk-… corresponde à do servidor?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errore di autenticazione %lld: %@ — controlla/rinnova la chiave API. Con un gateway tuo (sub2api): la chiave sk-… corrisponde a quella del server?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证错误 %lld：%@ — 请检查或更新 API 密钥。使用自建网关（sub2api）时：sk-… 密钥和服务器上的一致吗？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証エラー %lld: %@ — APIキーを確認・再発行してください。自前のゲートウェイ (sub2api) の場合、sk-… キーはサーバーと一致していますか？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка аутентификации %lld: %@ — проверь или обнови API-ключ. Если у тебя свой шлюз (sub2api): совпадает ли ключ sk-… с сервером?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ مصادقة %lld: %@ — تحقّق من مفتاح API أو جدّده. إذا كنت تستخدم بوابة خاصة بك (sub2api): هل يطابق مفتاح sk-… ما على الخادم؟"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auth त्रुटि %lld: %@ — API-Key जाँचें/नया बनाएँ। अपने Gateway (sub2api) के साथ: क्या sk-…-Key सर्वर से मेल खाता है?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Auth ত্রুটি %lld: %@ — API-Key যাচাই/নবীকরণ করুন। নিজস্ব Gateway (sub2api)-এর ক্ষেত্রে: sk-…-Key কি সার্ভারের সাথে মিলছে?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Auth خرابی %lld: %@ — API-Key چیک/تجدید کریں۔ اپنے Gateway (sub2api) کی صورت میں: کیا sk-…-Key سرور سے میل کھاتی ہے؟"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesalahan Auth %lld: %@ — periksa/perbarui API-Key. Untuk Gateway sendiri (sub2api): apakah Key sk-…- cocok dengan server?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auth hatası %lld: %@ — API-Key'i kontrol edin/yenileyin. Kendi Gateway'inizde (sub2api): sk-…-Key sunucuyla eşleşiyor mu?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi Auth %lld: %@ — kiểm tra/làm mới API-Key. Với Gateway riêng (sub2api): Key sk-…- có khớp với server không?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 오류 %lld: %@ — API-Key를 확인/갱신하세요. 자체 Gateway(sub2api)의 경우: sk-…-Key가 서버와 일치하나요?"
          }
        }
      }
    },
