          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " — الإعدادات → تحميل النماذج واختيار نموذج آخر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " — सेटिंग्स → मॉडल लोड करें और कोई दूसरा मॉडल चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": " — Settings → মডেল লোড করুন এবং অন্য মডেল বেছে নিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
