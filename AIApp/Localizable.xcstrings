    "Start an die App aus — meist beim übernächsten Öffnen. Bis dahin zählt ": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التشغيل القادم للتطبيق — غالباً عند الفتح الذي يليه. وحتى ذلك الحين يبقى "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "launch — usually the second time you open it. Until then, "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "arranque — normalmente al segundo. Hasta entonces cuenta "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "lancement — en général à la deuxième ouverture. D'ici là, seul compte "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "avvio — di solito alla seconda apertura. Fino ad allora conta "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動より後です — たいていは次の次に開いたとき。それまでは"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "arranque — normalmente só na abertura seguinte. Até lá conta "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "запуска — обычно при втором открытии. До тех пор важно "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动后才会把崩溃报告交给应用 — 通常是再下次打开时。在那之前，只能参考 "
          }
        }
      }
    },
